<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!--
        Theme: Modern Light — Design Language v2
        Philosophy: frosted white glass over a light splash backdrop.
        ═══════════════════════════════════════════════════════════════════
        Background:            #DDE3EE    splash tint / window base
        Surface:               #EEF2FA    sidebar / panels
        Chrome:                #DDE3EE    TUI shell / status bar
        TitleBar:              #DDE3EE    top bar
        MenuBackground:        #DDE3EE    menu / splash
        MenuHover:             #C8D0E0    menu item highlight
        SecondaryButton:       #EEF2FA    secondary window button idle
        SecondaryButtonBorder: #C0CADC    secondary button border
        Hover:                 #C8D0E0    hover state
        Pressed:               #B8C2D8    pressed state
        Text Primary:          #1F2937    primary text
        Text Secondary:        #6B7280    secondary text
        ButtonText:            #1F2937    button captions
        Border:                #C0CADC    borders
        Glass panel:           #CCF0F4FF  frosted white rgba(240,244,255,0.80)
        Glass border:          #241E283C  subtle dark  rgba(30,40,60,0.14)
        Glass highlight:       #99FFFFFF  top sheen    rgba(255,255,255,0.60)
        AccentTop:             #5AA1FF    (DL §5.2)
        AccentBot:             #1D4ED8    (DL §5.2)
        AccentGlow:            #991D4ED8  60 % opacity (DL §5.2)
        Corner radius:         button 8px, card 18px (DL §9)
    ═══════════════════════════════════════════════════════════════════ -->

    <!-- ── Metadata ── -->
    <sys:String x:Key="Theme.Meta.Name">Modern Light</sys:String>
    <sys:String x:Key="Theme.Meta.Variant">Light</sys:String>
    <sys:String x:Key="Theme.Meta.IconSet">ModernLight</sys:String>
    <sys:String x:Key="Theme.Meta.PaletteFamily">ModernPalette</sys:String>
    <sys:String x:Key="Theme.Meta.ButtonInteraction">HoverScanline</sys:String>

    <!-- ═══════════════════════════════════════════════════════ Colors -->

    <!-- Surfaces -->
    <Color x:Key="Theme.Color.Background">#DDE3EE</Color>
    <Color x:Key="Theme.Color.Surface">#EEF2FA</Color>
    <Color x:Key="Theme.Color.Chrome">#DDE3EE</Color>
    <Color x:Key="Theme.Color.TitleBar">#DDE3EE</Color>
    <Color x:Key="Theme.Color.MenuBackground">#DDE3EE</Color>
    <Color x:Key="Theme.Color.MenuHover">#C8D0E0</Color>
    <Color x:Key="Theme.Color.SecondaryButton">#EEF2FA</Color>
    <Color x:Key="Theme.Color.SecondaryButtonBorder">#C0CADC</Color>
    <Color x:Key="Theme.Color.Disabled">#E4E9F4</Color>
    <Color x:Key="Theme.Color.Hover">#C8D0E0</Color>
    <Color x:Key="Theme.Color.Pressed">#B8C2D8</Color>
    <Color x:Key="Theme.Color.Menu.Hover">#C8D0E0</Color>

    <!-- Typography -->
    <Color x:Key="Theme.Color.Text.Primary">#1F2937</Color>
    <Color x:Key="Theme.Color.Text.Secondary">#6B7280</Color>
    <Color x:Key="Theme.Color.ButtonText">#1F2937</Color>

    <!-- Structure -->
    <Color x:Key="Theme.Color.Border">#C0CADC</Color>
    <Color x:Key="Theme.Color.WindowBackground">#EEF2FA</Color>

    <!-- Semantic -->
    <Color x:Key="Theme.Color.Success">#16A34A</Color>
    <Color x:Key="Theme.Color.Danger">#DC2626</Color>
    <Color x:Key="Theme.Color.Warning">#D97706</Color>

    <!-- Action tint backgrounds -->
    <Color x:Key="Theme.Color.ActionPositive">#DCFCE7</Color>
    <Color x:Key="Theme.Color.ActionDanger">#FEE2E2</Color>
    <Color x:Key="Theme.Color.ActionUtility">#DBEAFE</Color>

    <!-- Splash -->
    <Color x:Key="Theme.Color.SplashModernBackground">#DDE3EE</Color>

    <!-- Accent — same blue as Modern Dark (DL §5.2) -->
    <Color x:Key="Theme.Color.AccentTop">#5AA1FF</Color>
    <Color x:Key="Theme.Color.AccentBot">#1D4ED8</Color>
    <Color x:Key="Theme.Color.AccentGlow">#991D4ED8</Color>

    <!-- Glass tokens — frosted white panel -->
    <!-- GlassPanel.Background: rgba(240,244,255,0.80) → #CCF0F4FF -->
    <!-- GlassBorder:           rgba(30,40,60,0.14)    → #241E283C  -->
    <!-- GlassHighlight:        rgba(255,255,255,0.60) → #99FFFFFF  -->
    <Color x:Key="Theme.Color.GlassPanel.Background">#CCF0F4FF</Color>
    <Color x:Key="Theme.Color.GlassBorder">#241E283C</Color>
    <Color x:Key="Theme.Color.GlassHighlight">#99FFFFFF</Color>

    <!-- Window controls: dark-on-light glass -->
    <!-- Idle:   rgba(30,40,60,0.06) → #0F1E283C  -->
    <!-- Hover:  rgba(30,40,60,0.12) → #1E1E283C  -->
    <!-- Border: rgba(30,40,60,0.14) → #241E283C  -->
    <!-- Close:  rgba(239,68,68,0.85)→ #D9EF4444  -->
    <Color x:Key="Theme.Color.WinCtrl.Idle">#0F1E283C</Color>
    <Color x:Key="Theme.Color.WinCtrl.Hover">#1E1E283C</Color>
    <Color x:Key="Theme.Color.WinCtrl.Border">#241E283C</Color>
    <Color x:Key="Theme.Color.WinCtrl.Close">#D9EF4444</Color>

    <!-- ═══════════════════════════════════════════════════════ Brushes -->

    <!-- Surfaces -->
    <SolidColorBrush x:Key="Theme.Brush.Background"            Color="{StaticResource Theme.Color.Background}" />
    <SolidColorBrush x:Key="Theme.Brush.Surface"               Color="{StaticResource Theme.Color.Surface}" />
    <SolidColorBrush x:Key="Theme.Brush.Chrome"                Color="{StaticResource Theme.Color.Chrome}" />
    <SolidColorBrush x:Key="Theme.Brush.TitleBar"              Color="{StaticResource Theme.Color.TitleBar}" />
    <SolidColorBrush x:Key="Theme.Brush.MenuBackground"        Color="{StaticResource Theme.Color.MenuBackground}" />
    <SolidColorBrush x:Key="Theme.Brush.MenuHover"             Color="{StaticResource Theme.Color.MenuHover}" />
    <SolidColorBrush x:Key="Theme.Brush.SecondaryButton"       Color="{StaticResource Theme.Color.SecondaryButton}" />
    <SolidColorBrush x:Key="Theme.Brush.SecondaryButtonBorder" Color="{StaticResource Theme.Color.SecondaryButtonBorder}" />
    <SolidColorBrush x:Key="Theme.Brush.Disabled"              Color="{StaticResource Theme.Color.Disabled}" />
    <SolidColorBrush x:Key="Theme.Brush.Hover"                 Color="{StaticResource Theme.Color.Hover}" />
    <SolidColorBrush x:Key="Theme.Brush.Pressed"               Color="{StaticResource Theme.Color.Pressed}" />
    <SolidColorBrush x:Key="Theme.Brush.Menu.Hover"            Color="{StaticResource Theme.Color.Menu.Hover}" />

    <!-- Typography -->
    <SolidColorBrush x:Key="Theme.Brush.Text.Primary"          Color="{StaticResource Theme.Color.Text.Primary}" />
    <SolidColorBrush x:Key="Theme.Brush.Text.Secondary"        Color="{StaticResource Theme.Color.Text.Secondary}" />
    <SolidColorBrush x:Key="Theme.Brush.ButtonText"            Color="{StaticResource Theme.Color.ButtonText}" />

    <!-- Structure -->
    <SolidColorBrush x:Key="Theme.Brush.Border"                Color="{StaticResource Theme.Color.Border}" />
    <SolidColorBrush x:Key="Theme.Brush.WindowBackground"      Color="{StaticResource Theme.Color.WindowBackground}" />

    <!-- Action tints -->
    <SolidColorBrush x:Key="Brush.ActionPositive"              Color="{StaticResource Theme.Color.ActionPositive}" />
    <SolidColorBrush x:Key="Brush.ActionDanger"                Color="{StaticResource Theme.Color.ActionDanger}" />
    <SolidColorBrush x:Key="Brush.ActionUtility"               Color="{StaticResource Theme.Color.ActionUtility}" />

    <!-- Splash -->
    <SolidColorBrush x:Key="Brush.SplashModernBackground"      Color="{StaticResource Theme.Color.SplashModernBackground}" />

    <!-- Accent -->
    <SolidColorBrush x:Key="Theme.Brush.AccentTop"             Color="{StaticResource Theme.Color.AccentTop}" />
    <SolidColorBrush x:Key="Theme.Brush.AccentBot"             Color="{StaticResource Theme.Color.AccentBot}" />
    <SolidColorBrush x:Key="Theme.Brush.AccentGlow"            Color="{StaticResource Theme.Color.AccentGlow}" />

    <!-- Glass brushes -->
    <SolidColorBrush x:Key="Theme.Brush.GlassPanel.Background" Color="{StaticResource Theme.Color.GlassPanel.Background}" />
    <SolidColorBrush x:Key="Theme.Brush.GlassBorder"           Color="{StaticResource Theme.Color.GlassBorder}" />
    <SolidColorBrush x:Key="Theme.Brush.GlassHighlight"        Color="{StaticResource Theme.Color.GlassHighlight}" />
    <SolidColorBrush x:Key="Theme.Brush.WinCtrl.Idle"          Color="{StaticResource Theme.Color.WinCtrl.Idle}" />
    <SolidColorBrush x:Key="Theme.Brush.WinCtrl.Hover"         Color="{StaticResource Theme.Color.WinCtrl.Hover}" />
    <SolidColorBrush x:Key="Theme.Brush.WinCtrl.Border"        Color="{StaticResource Theme.Color.WinCtrl.Border}" />
    <SolidColorBrush x:Key="Theme.Brush.WinCtrl.Close"         Color="{StaticResource Theme.Color.WinCtrl.Close}" />

    <!-- ═══════════════════════════════════════════════════════ Named styles -->

    <Style x:Key="Theme.Style.Window" TargetType="Window">
        <Setter Property="Background" Value="{StaticResource Theme.Brush.Background}" />
        <Setter Property="Foreground" Value="{StaticResource Theme.Brush.Text.Primary}" />
    </Style>

    <!-- Card-radius GroupBox (DL §9 card = 18 px) -->
    <Style x:Key="Theme.Style.GroupBox" TargetType="GroupBox">
        <Setter Property="Background"      Value="{StaticResource Theme.Brush.Surface}" />
        <Setter Property="BorderBrush"     Value="{StaticResource Theme.Brush.Border}" />
        <Setter Property="Foreground"      Value="{StaticResource Theme.Brush.Text.Primary}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="GroupBox">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Border Grid.Row="0" Grid.RowSpan="2"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="18" />
                        <Border Grid.Row="0" Padding="10,6,10,0">
                            <ContentPresenter ContentSource="Header"
                                              RecognizesAccessKey="True"
                                              TextElement.Foreground="{TemplateBinding Foreground}" />
                        </Border>
                        <ContentPresenter Grid.Row="1" Margin="6,4,6,6" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- DL §7.5 secondary button: frosted bg, subtle dark border, radius 8 -->
    <Style x:Key="Theme.Style.Button" TargetType="Button">
        <Setter Property="Background"                 Value="{StaticResource Theme.Brush.SecondaryButton}" />
        <Setter Property="Foreground"                 Value="{StaticResource Theme.Brush.Text.Primary}" />
        <Setter Property="BorderBrush"                Value="{StaticResource Theme.Brush.SecondaryButtonBorder}" />
        <Setter Property="BorderThickness"            Value="1" />
        <Setter Property="Padding"                    Value="12,6" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment"   Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Root"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="8"
                            SnapsToDevicePixels="True">
                        <ContentPresenter
                            HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                            Margin="{TemplateBinding Padding}"
                            RecognizesAccessKey="True" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Background"
                                    Value="{StaticResource Theme.Brush.Hover}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Root" Property="Background"
                                    Value="{StaticResource Theme.Brush.Pressed}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Root" Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Glass window control (dark-on-light, Tag = hover brush) -->
    <Style x:Key="Theme.Style.WinCtrl" TargetType="Button">
        <Setter Property="Background"       Value="{StaticResource Theme.Brush.WinCtrl.Idle}" />
        <Setter Property="BorderBrush"      Value="{StaticResource Theme.Brush.WinCtrl.Border}" />
        <Setter Property="BorderThickness"  Value="1" />
        <Setter Property="Foreground"       Value="{StaticResource Theme.Brush.Text.Primary}" />
        <Setter Property="Width"            Value="44" />
        <Setter Property="Height"           Value="34" />
        <Setter Property="Padding"          Value="0" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Tag"              Value="{StaticResource Theme.Brush.WinCtrl.Hover}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Root"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="10"
                            SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Background"
                                    Value="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=Tag}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Root" Property="Background"
                                    Value="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=Tag}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Close button: red hover via Tag override -->
    <Style x:Key="Theme.Style.WinCtrl.Close" BasedOn="{StaticResource Theme.Style.WinCtrl}" TargetType="Button">
        <Setter Property="Tag" Value="{StaticResource Theme.Brush.WinCtrl.Close}" />
    </Style>

    <Style x:Key="Theme.Style.TextBlock" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource Theme.Brush.Text.Primary}" />
    </Style>

    <Style x:Key="Theme.Style.ListBox" TargetType="ListBox">
        <Setter Property="Background"  Value="{StaticResource Theme.Brush.Surface}" />
        <Setter Property="BorderBrush" Value="{StaticResource Theme.Brush.Border}" />
        <Setter Property="Foreground"  Value="{StaticResource Theme.Brush.Text.Primary}" />
    </Style>

</ResourceDictionary>
