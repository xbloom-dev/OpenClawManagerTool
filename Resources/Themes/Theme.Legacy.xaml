<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!--
        Theme: Legacy
        Zachovává výchozí WPF vzhled (SystemColors).
        Žádné přepsání barev ani stylů — aplikace vypadá jako v0.4.
        Ikony: emoji TextBlock (zabudováno přímo v XAML tlačítek).
    -->

    <sys:String x:Key="Theme.Meta.Name">Theme.Legacy</sys:String>

    <Color x:Key="Theme.Color.ActionPositive">#D0FFD0</Color>
    <Color x:Key="Theme.Color.ActionDanger">#FFD0D0</Color>
    <Color x:Key="Theme.Color.ActionUtility">#D0E8FF</Color>
    <Color x:Key="Theme.Color.SplashModernBackground">#4C247E</Color>

    <SolidColorBrush x:Key="Brush.ActionPositive" Color="{StaticResource Theme.Color.ActionPositive}" />
    <SolidColorBrush x:Key="Brush.ActionDanger" Color="{StaticResource Theme.Color.ActionDanger}" />
    <SolidColorBrush x:Key="Brush.ActionUtility" Color="{StaticResource Theme.Color.ActionUtility}" />
    <SolidColorBrush x:Key="Brush.SplashModernBackground" Color="{StaticResource Theme.Color.SplashModernBackground}" />
    <SolidColorBrush x:Key="Theme.Brush.Disabled" Color="#F0F0F0" />
    <SolidColorBrush x:Key="Theme.Brush.ButtonText" Color="#000000" />
    <SolidColorBrush x:Key="Theme.Brush.Hover" Color="#E5E5E5" />
    <SolidColorBrush x:Key="Theme.Brush.Pressed" Color="#DADADA" />
    <SolidColorBrush x:Key="Theme.Brush.OutputBackground" Color="#FFFFFF" />
    <SolidColorBrush x:Key="Theme.Brush.OutputText" Color="#000000" />
    <SolidColorBrush x:Key="Theme.Brush.OutputBorder" Color="#808080" />
    <SolidColorBrush x:Key="Theme.Brush.ShortcutBackground" Color="#F5F5F5" />
    <SolidColorBrush x:Key="Theme.Brush.ShortcutBorder" Color="#E0E0E0" />
    <SolidColorBrush x:Key="Theme.Brush.ShortcutKeyText" Color="#0066CC" />

</ResourceDictionary>
