<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!--
        Theme: Standard Dark
        Vychází ze Standard tématu, používá původní Modern PNG ikony.

        Povolená paleta:
        #121212 Chrome / TUI / status bar / title bar
        #282828 Surface / základní plocha / idle tlačítka
        #464646 Border / hover / text hlavního okna
        #535353 Accent / pressed
        #FFFFFF Primary text / text tlačítek
        #A0A0A0 Secondary text / sekundární okna a doplňkové texty
    -->

    <!-- ── Metadata ── -->
    <sys:String x:Key="Theme.Meta.Name">Standard Dark</sys:String>
    <sys:String x:Key="Theme.Meta.Variant">Dark</sys:String>
    <sys:String x:Key="Theme.Meta.IconSet">Modern</sys:String>
    <sys:String x:Key="Theme.Meta.PaletteFamily">Standard</sys:String>
    <sys:String x:Key="Theme.Meta.ButtonInteraction">PressScanlineNoShift</sys:String>

    <!-- ── Barvy ── -->
    <Color x:Key="Theme.Color.Background">#282828</Color>
    <Color x:Key="Theme.Color.WindowBackground">#464646</Color>
    <Color x:Key="Theme.Color.Surface">#282828</Color>
    <Color x:Key="Theme.Color.Chrome">#121212</Color>
    <Color x:Key="Theme.Color.Accent">#535353</Color>
    <Color x:Key="Theme.Color.Text.Primary">#FFFFFF</Color>
    <Color x:Key="Theme.Color.Text.Secondary">#A0A0A0</Color>
    <Color x:Key="Theme.Color.MainText">#464646</Color>
    <Color x:Key="Theme.Color.Border">#464646</Color>
    <Color x:Key="Theme.Color.Hover">#464646</Color>
    <Color x:Key="Theme.Color.Menu.Hover">#464646</Color>
    <Color x:Key="Theme.Color.Pressed">#535353</Color>
    <Color x:Key="Theme.Color.Disabled">#282828</Color>
    <Color x:Key="Theme.Color.ButtonText">#FFFFFF</Color>
    <Color x:Key="Theme.Color.Success">#535353</Color>
    <Color x:Key="Theme.Color.Danger">#535353</Color>
    <Color x:Key="Theme.Color.Warning">#535353</Color>
    <Color x:Key="Theme.Color.ActionPositive">#282828</Color>
    <Color x:Key="Theme.Color.ActionDanger">#282828</Color>
    <Color x:Key="Theme.Color.ActionUtility">#282828</Color>
    <Color x:Key="Theme.Color.SplashModernBackground">#121212</Color>

    <!-- ── Brushe ── -->
    <SolidColorBrush x:Key="Theme.Brush.Background" Color="{StaticResource Theme.Color.Background}" />
    <SolidColorBrush x:Key="Theme.Brush.WindowBackground" Color="{StaticResource Theme.Color.WindowBackground}" />
    <SolidColorBrush x:Key="Theme.Brush.Surface" Color="{StaticResource Theme.Color.Surface}" />
    <SolidColorBrush x:Key="Theme.Brush.Chrome" Color="{StaticResource Theme.Color.Chrome}" />
    <SolidColorBrush x:Key="Theme.Brush.Accent" Color="{StaticResource Theme.Color.Accent}" />
    <SolidColorBrush x:Key="Theme.Brush.Text.Primary" Color="{StaticResource Theme.Color.Text.Primary}" />
    <SolidColorBrush x:Key="Theme.Brush.Text.Secondary" Color="{StaticResource Theme.Color.Text.Secondary}" />
    <SolidColorBrush x:Key="Theme.Brush.MainText" Color="{StaticResource Theme.Color.MainText}" />
    <SolidColorBrush x:Key="Theme.Brush.Border" Color="{StaticResource Theme.Color.Border}" />
    <SolidColorBrush x:Key="Theme.Brush.Hover" Color="{StaticResource Theme.Color.Hover}" />
    <SolidColorBrush x:Key="Theme.Brush.Menu.Hover" Color="{StaticResource Theme.Color.Menu.Hover}" />
    <SolidColorBrush x:Key="Theme.Brush.Pressed" Color="{StaticResource Theme.Color.Pressed}" />
    <SolidColorBrush x:Key="Theme.Brush.Disabled" Color="{StaticResource Theme.Color.Disabled}" />
    <SolidColorBrush x:Key="Theme.Brush.ButtonText" Color="{StaticResource Theme.Color.ButtonText}" />
    <SolidColorBrush x:Key="Brush.ActionPositive" Color="{StaticResource Theme.Color.ActionPositive}" />
    <SolidColorBrush x:Key="Brush.ActionDanger" Color="{StaticResource Theme.Color.ActionDanger}" />
    <SolidColorBrush x:Key="Brush.ActionUtility" Color="{StaticResource Theme.Color.ActionUtility}" />
    <SolidColorBrush x:Key="Brush.SplashModernBackground" Color="{StaticResource Theme.Color.SplashModernBackground}" />

    <!-- ── Základní styly pro sekundární okna ── -->
    <Style x:Key="Theme.Style.Window" TargetType="Window">
        <Setter Property="Background" Value="{StaticResource Theme.Brush.WindowBackground}" />
        <Setter Property="Foreground" Value="{StaticResource Theme.Brush.Text.Primary}" />
    </Style>

    <Style x:Key="Theme.Style.GroupBox" TargetType="GroupBox">
        <Setter Property="Background" Value="{StaticResource Theme.Brush.Surface}" />
        <Setter Property="BorderBrush" Value="{StaticResource Theme.Brush.Border}" />
        <Setter Property="Foreground" Value="{StaticResource Theme.Brush.Text.Primary}" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>

    <Style x:Key="Theme.Style.Button" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource Theme.Brush.Disabled}" />
        <Setter Property="Foreground" Value="{StaticResource Theme.Brush.ButtonText}" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="8,4" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource Theme.Brush.Hover}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="{StaticResource Theme.Brush.Pressed}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Background" Value="{StaticResource Theme.Brush.Disabled}" />
                <Setter Property="Opacity" Value="0.55" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="Theme.Style.TextBlock" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource Theme.Brush.Text.Primary}" />
    </Style>

    <Style x:Key="Theme.Style.ListBox" TargetType="ListBox">
        <Setter Property="Background" Value="{StaticResource Theme.Brush.Surface}" />
        <Setter Property="BorderBrush" Value="{StaticResource Theme.Brush.Border}" />
        <Setter Property="Foreground" Value="{StaticResource Theme.Brush.Text.Primary}" />
    </Style>

    <Style TargetType="Window" BasedOn="{StaticResource Theme.Style.Window}" />
    <Style TargetType="GroupBox" BasedOn="{StaticResource Theme.Style.GroupBox}" />
    <Style TargetType="Button" BasedOn="{StaticResource Theme.Style.Button}" />
    <Style TargetType="TextBlock" BasedOn="{StaticResource Theme.Style.TextBlock}" />
    <Style TargetType="ListBox" BasedOn="{StaticResource Theme.Style.ListBox}" />

    <Style TargetType="TextBox">
        <Setter Property="Background" Value="{StaticResource Theme.Brush.Surface}" />
        <Setter Property="Foreground" Value="{StaticResource Theme.Brush.Text.Primary}" />
        <Setter Property="BorderBrush" Value="{StaticResource Theme.Brush.Border}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CaretBrush" Value="{StaticResource Theme.Brush.Text.Primary}" />
        <Setter Property="SelectionBrush" Value="{StaticResource Theme.Brush.Accent}" />
    </Style>

    <Style TargetType="PasswordBox">
        <Setter Property="Background" Value="{StaticResource Theme.Brush.Surface}" />
        <Setter Property="Foreground" Value="{StaticResource Theme.Brush.Text.Primary}" />
        <Setter Property="BorderBrush" Value="{StaticResource Theme.Brush.Border}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CaretBrush" Value="{StaticResource Theme.Brush.Text.Primary}" />
        <Setter Property="SelectionBrush" Value="{StaticResource Theme.Brush.Accent}" />
    </Style>

    <Style TargetType="CheckBox">
        <Setter Property="Foreground" Value="{StaticResource Theme.Brush.Text.Primary}" />
    </Style>

    <Style TargetType="RadioButton">
        <Setter Property="Foreground" Value="{StaticResource Theme.Brush.Text.Primary}" />
    </Style>

    <Style TargetType="ComboBox">
        <Setter Property="Background" Value="{StaticResource Theme.Brush.Surface}" />
        <Setter Property="Foreground" Value="{StaticResource Theme.Brush.Text.Primary}" />
        <Setter Property="BorderBrush" Value="{StaticResource Theme.Brush.Border}" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>

    <Style TargetType="ListBoxItem">
        <Setter Property="Background" Value="{StaticResource Theme.Brush.Surface}" />
        <Setter Property="Foreground" Value="{StaticResource Theme.Brush.Text.Primary}" />
    </Style>

    <Style TargetType="DataGrid">
        <Setter Property="Background" Value="{StaticResource Theme.Brush.Surface}" />
        <Setter Property="Foreground" Value="{StaticResource Theme.Brush.Text.Primary}" />
        <Setter Property="BorderBrush" Value="{StaticResource Theme.Brush.Border}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="GridLinesVisibility" Value="None" />
        <Setter Property="RowBackground" Value="{StaticResource Theme.Brush.Surface}" />
        <Setter Property="AlternatingRowBackground" Value="{StaticResource Theme.Brush.Background}" />
        <Setter Property="HorizontalGridLinesBrush" Value="{StaticResource Theme.Brush.Border}" />
        <Setter Property="VerticalGridLinesBrush" Value="{StaticResource Theme.Brush.Border}" />
    </Style>

    <Style TargetType="StatusBar">
        <Setter Property="Background" Value="{StaticResource Theme.Brush.Chrome}" />
        <Setter Property="Foreground" Value="{StaticResource Theme.Brush.Text.Secondary}" />
    </Style>

    <Style TargetType="ToolTip">
        <Setter Property="Background" Value="{StaticResource Theme.Brush.Surface}" />
        <Setter Property="Foreground" Value="{StaticResource Theme.Brush.Text.Primary}" />
        <Setter Property="BorderBrush" Value="{StaticResource Theme.Brush.Border}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="6,4" />
    </Style>

</ResourceDictionary>
