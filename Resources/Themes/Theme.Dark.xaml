<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        Theme: Dark (Dark Slate — paleta B)
        Vychází z: Modern (stejná struktura tokenů a x:Key styly)
        ═══════════════════════════════════════════════════════════════════
        Pozadí okna:     #181A1F
        Panely/GroupBox: #242832
        Akcent:          #4CC2FF    světle modrá
        Text primární:   #F3F7FA
        Text sekundární: #AAB4C0
        Ohraničení:      #3A4250
        Button hover:    #2E3444
        Button pressed:  #38404F
        ActionPositive:  #143D2A    TUI, Spustit, [REDACT]
        ActionDanger:    #4A1E24    Zavřít, Zrušit, Obnovit, Opravit
        ActionUtility:   #183A52    Kopírovat, Náhled, Procházet
        SplashBackground:#2B174C    tmavě fialové splash pozadí
        ═══════════════════════════════════════════════════════════════════
        Přidání nového tématu:
          1. Zkopírovat tento soubor jako Theme.{Název}.xaml
          2. Přepsat hodnoty Color/Brush
          3. Registrovat v ThemeService._themeResourcePaths
        ═══════════════════════════════════════════════════════════════════
    -->

    <!-- ── Barvy ── -->
    <Color x:Key="Theme.Color.Background">#181A1F</Color>
    <Color x:Key="Theme.Color.Surface">#242832</Color>
    <Color x:Key="Theme.Color.Accent">#4CC2FF</Color>
    <Color x:Key="Theme.Color.Text.Primary">#F3F7FA</Color>
    <Color x:Key="Theme.Color.Text.Secondary">#AAB4C0</Color>
    <Color x:Key="Theme.Color.Border">#3A4250</Color>
    <Color x:Key="Theme.Color.Hover">#2E3444</Color>
    <Color x:Key="Theme.Color.Pressed">#38404F</Color>
    <Color x:Key="Theme.Color.Success">#38C172</Color>
    <Color x:Key="Theme.Color.Danger">#FF6B7A</Color>
    <Color x:Key="Theme.Color.Warning">#F6C177</Color>
    <Color x:Key="Theme.Color.ActionPositive">#143D2A</Color>
    <Color x:Key="Theme.Color.ActionDanger">#4A1E24</Color>
    <Color x:Key="Theme.Color.ActionUtility">#183A52</Color>
    <Color x:Key="Theme.Color.SplashModernBackground">#2B174C</Color>

    <!-- ── Brushe ── -->
    <SolidColorBrush x:Key="Theme.Brush.Background"     Color="{StaticResource Theme.Color.Background}" />
    <SolidColorBrush x:Key="Theme.Brush.Surface"        Color="{StaticResource Theme.Color.Surface}" />
    <SolidColorBrush x:Key="Theme.Brush.Accent"         Color="{StaticResource Theme.Color.Accent}" />
    <SolidColorBrush x:Key="Theme.Brush.Text.Primary"   Color="{StaticResource Theme.Color.Text.Primary}" />
    <SolidColorBrush x:Key="Theme.Brush.Text.Secondary" Color="{StaticResource Theme.Color.Text.Secondary}" />
    <SolidColorBrush x:Key="Theme.Brush.Border"         Color="{StaticResource Theme.Color.Border}" />
    <SolidColorBrush x:Key="Theme.Brush.Hover"          Color="{StaticResource Theme.Color.Hover}" />
    <SolidColorBrush x:Key="Theme.Brush.Pressed"        Color="{StaticResource Theme.Color.Pressed}" />
    <SolidColorBrush x:Key="Brush.ActionPositive"       Color="{StaticResource Theme.Color.ActionPositive}" />
    <SolidColorBrush x:Key="Brush.ActionDanger"         Color="{StaticResource Theme.Color.ActionDanger}" />
    <SolidColorBrush x:Key="Brush.ActionUtility"        Color="{StaticResource Theme.Color.ActionUtility}" />
    <SolidColorBrush x:Key="Brush.SplashModernBackground" Color="{StaticResource Theme.Color.SplashModernBackground}" />

    <!-- ── Styly ── -->

    <!-- Window pozadí -->
    <Style x:Key="Theme.Style.Window" TargetType="Window">
        <Setter Property="Background" Value="{StaticResource Theme.Brush.Background}" />
        <Setter Property="Foreground" Value="{StaticResource Theme.Brush.Text.Primary}" />
    </Style>

    <!-- GroupBox -->
    <Style x:Key="Theme.Style.GroupBox" TargetType="GroupBox">
        <Setter Property="Background"      Value="{StaticResource Theme.Brush.Surface}" />
        <Setter Property="BorderBrush"     Value="{StaticResource Theme.Brush.Border}" />
        <Setter Property="Foreground"      Value="{StaticResource Theme.Brush.Text.Primary}" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>

    <!-- Button — tmavé hover/pressed barvy (opraveno oproti copy-paste z Modern) -->
    <Style x:Key="Theme.Style.Button" TargetType="Button">
        <Setter Property="Background"      Value="{StaticResource Theme.Brush.Surface}" />
        <Setter Property="Foreground"      Value="{StaticResource Theme.Brush.Text.Primary}" />
        <Setter Property="BorderBrush"     Value="{StaticResource Theme.Brush.Border}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding"         Value="8,4" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource Theme.Brush.Hover}" />
                <Setter Property="BorderBrush" Value="{StaticResource Theme.Brush.Accent}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="{StaticResource Theme.Brush.Pressed}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.45" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- TextBlock primární -->
    <Style x:Key="Theme.Style.TextBlock" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource Theme.Brush.Text.Primary}" />
    </Style>

    <!-- ListBox (AppLog) -->
    <Style x:Key="Theme.Style.ListBox" TargetType="ListBox">
        <Setter Property="Background"  Value="{StaticResource Theme.Brush.Surface}" />
        <Setter Property="BorderBrush" Value="{StaticResource Theme.Brush.Border}" />
        <Setter Property="Foreground"  Value="{StaticResource Theme.Brush.Text.Primary}" />
    </Style>

</ResourceDictionary>
