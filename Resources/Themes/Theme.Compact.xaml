<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        Theme: Compact (Light Modern dense controls)
        ═══════════════════════════════════════════════════════════════════
        Barvy:
          Pozadí okna:    #F4F6FA
          Panely/GroupBox: #FFFFFF
          Akcent:         #2563EB
          Text primární:  #1A1A2E
          Text sekundární: #6B7280
          Ohraničení:     #E5E7EB
        ═══════════════════════════════════════════════════════════════════
        Přidání nového tématu:
          1. Zkopírovat tento soubor jako Theme.{Název}.xaml
          2. Přepsat hodnoty Color/Brush
          3. Registrovat v ThemeService._themeResourcePaths
        ═══════════════════════════════════════════════════════════════════
    -->

    <!-- ── Barvy ── -->
    <Color x:Key="Theme.Color.Background">#F4F6FA</Color>
    <Color x:Key="Theme.Color.Surface">#FFFFFF</Color>
    <Color x:Key="Theme.Color.Accent">#2563EB</Color>
    <Color x:Key="Theme.Color.Text.Primary">#1A1A2E</Color>
    <Color x:Key="Theme.Color.Text.Secondary">#6B7280</Color>
    <Color x:Key="Theme.Color.Border">#E5E7EB</Color>
    <Color x:Key="Theme.Color.Success">#16A34A</Color>
    <Color x:Key="Theme.Color.Danger">#DC2626</Color>
    <Color x:Key="Theme.Color.Warning">#D97706</Color>
    <Color x:Key="Theme.Color.ActionPositive">#D0FFD0</Color>
    <Color x:Key="Theme.Color.ActionDanger">#FFD0D0</Color>
    <Color x:Key="Theme.Color.ActionUtility">#D0E8FF</Color>
    <Color x:Key="Theme.Color.SplashModernBackground">#4C247E</Color>

    <!-- ── Brushe ── -->
    <SolidColorBrush x:Key="Theme.Brush.Background"  Color="{StaticResource Theme.Color.Background}" />
    <SolidColorBrush x:Key="Theme.Brush.Surface"     Color="{StaticResource Theme.Color.Surface}" />
    <SolidColorBrush x:Key="Theme.Brush.Accent"      Color="{StaticResource Theme.Color.Accent}" />
    <SolidColorBrush x:Key="Theme.Brush.Text.Primary"   Color="{StaticResource Theme.Color.Text.Primary}" />
    <SolidColorBrush x:Key="Theme.Brush.Text.Secondary" Color="{StaticResource Theme.Color.Text.Secondary}" />
    <SolidColorBrush x:Key="Theme.Brush.Border"      Color="{StaticResource Theme.Color.Border}" />
    <SolidColorBrush x:Key="Brush.ActionPositive" Color="{StaticResource Theme.Color.ActionPositive}" />
    <SolidColorBrush x:Key="Brush.ActionDanger" Color="{StaticResource Theme.Color.ActionDanger}" />
    <SolidColorBrush x:Key="Brush.ActionUtility" Color="{StaticResource Theme.Color.ActionUtility}" />
    <SolidColorBrush x:Key="Brush.SplashModernBackground" Color="{StaticResource Theme.Color.SplashModernBackground}" />

    <!-- ── Styly ── -->

    <!-- Window pozadí -->
    <Style x:Key="Theme.Style.Window" TargetType="Window">
        <Setter Property="Background" Value="{StaticResource Theme.Brush.Background}" />
        <Setter Property="Foreground" Value="{StaticResource Theme.Brush.Text.Primary}" />
    </Style>

    <!-- GroupBox -->
    <Style x:Key="Theme.Style.GroupBox" TargetType="GroupBox">
        <Setter Property="Background"   Value="{StaticResource Theme.Brush.Surface}" />
        <Setter Property="BorderBrush"  Value="{StaticResource Theme.Brush.Border}" />
        <Setter Property="Foreground"   Value="{StaticResource Theme.Brush.Text.Primary}" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>

    <!-- Tlačítko (základní Modern styl) -->
    <Style x:Key="Theme.Style.Button" TargetType="Button">
        <Setter Property="Background"   Value="{StaticResource Theme.Brush.Surface}" />
        <Setter Property="Foreground"   Value="{StaticResource Theme.Brush.Text.Primary}" />
        <Setter Property="BorderBrush"  Value="{StaticResource Theme.Brush.Border}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding"      Value="6,2" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="#EFF6FF" />
                <Setter Property="BorderBrush" Value="{StaticResource Theme.Brush.Accent}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="#DBEAFE" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.45" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- TextBlock primární -->
    <Style x:Key="Theme.Style.TextBlock" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource Theme.Brush.Text.Primary}" />
    </Style>

    <!-- ListBox (AppLog) -->
    <Style x:Key="Theme.Style.ListBox" TargetType="ListBox">
        <Setter Property="Background"  Value="{StaticResource Theme.Brush.Surface}" />
        <Setter Property="BorderBrush" Value="{StaticResource Theme.Brush.Border}" />
        <Setter Property="Foreground"  Value="{StaticResource Theme.Brush.Text.Primary}" />
    </Style>

</ResourceDictionary>
