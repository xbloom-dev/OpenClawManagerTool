<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
    <Version>1.0.0</Version>
    <ApplicationIcon>Resources\app-icon.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.Management" Version="8.0.0" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2792.45" />
  </ItemGroup>

  <ItemGroup>
    <!-- Ikona EXE souboru — Průzkumník, zástupce na ploše (jednodušší design) -->
    <Resource Include="Resources\app-icon.ico" />

    <!-- v0.5: Favicon okna — záhlaví (title bar), Taskbar, Alt+Tab (detailnější design) -->
    <Resource Include="Resources\app-favicon.ico" />

    <!-- Jazykové soubory — ResourceDictionary -->
    <Resource Include="Resources\Lang\Strings.en.xaml" />
    <Resource Include="Resources\Lang\Strings.cs.xaml" />

    <!-- v0.5: ResourceDictionary pro témata -->
    <Resource Include="Resources\Themes\Theme.Legacy.xaml" />
    <Resource Include="Resources\Themes\Theme.Modern.xaml" />
    <Resource Include="Resources\Themes\Theme.Dark.xaml" />
    <Resource Include="Resources\Themes\Theme.HighContrast.xaml" />
    <Resource Include="Resources\Themes\Theme.Compact.xaml" />

    <!-- v0.5: Ikony Modern tématu (PNG 48×48, konvertováno ze SVG) -->
    <Resource Include="Resources\Icons\Modern\start.png" />
    <Resource Include="Resources\Icons\Modern\stop.png" />
    <Resource Include="Resources\Icons\Modern\restart.png" />
    <Resource Include="Resources\Icons\Modern\powershell.png" />
    <Resource Include="Resources\Icons\Modern\gateway-log.png" />
    <Resource Include="Resources\Icons\Modern\cleaning-tool.png" />
    <Resource Include="Resources\Icons\Modern\token-manager.png" />
    <Resource Include="Resources\Icons\Modern\doctor-fix.png" />

    <!-- v1.0: Offline xterm.js assets for embedded terminal -->
    <Resource Include="Resources\Terminal\xterm.min.js" />
    <Resource Include="Resources\Terminal\xterm.min.css" />

    <!-- SVG logo pro dialog O aplikaci — zkopírovat vedle EXE při buildu -->
    <None Include="Resources\app-logo.svg">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>

    <!-- v0.5: Splash PNG fallback — embedded resource (graceful degradation když chybí .mp4) -->
    <Resource Include="Resources\splash.png" />

    <!-- v0.5: Splash video — vedle EXE (WMF/MediaElement potřebuje file path) -->
    <None Include="Resources\splash.mp4">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <!-- Test runner zije vedle aplikace, ale neni soucast WPF buildu. -->
    <Compile Remove="TokenService.Tests\**\*.cs" />
    <Page Remove="TokenService.Tests\**\*.xaml" />
    <EmbeddedResource Remove="TokenService.Tests\**" />
    <None Remove="TokenService.Tests\**" />
  </ItemGroup>

</Project>
