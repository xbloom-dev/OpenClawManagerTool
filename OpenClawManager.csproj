<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AssemblyVersion>2.0.3.0</AssemblyVersion>
    <FileVersion>2.0.3.0</FileVersion>
    <Version>2.0.3</Version>
    <ApplicationIcon>Resources\app-icon.ico</ApplicationIcon>
  </PropertyGroup>

  <PropertyGroup Condition="'$(BuildProfile)' == 'Lite'">
    <DefineConstants>$(DefineConstants);LITE_BUILD</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.2.2" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="8.0.0" />
    <PackageReference Include="System.Management" Version="8.0.0" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2792.45" />
  </ItemGroup>

  <ItemGroup>
    <!-- Ikona EXE souboru — Průzkumník, zástupce na ploše (jednodušší design) -->
    <Resource Include="Resources\app-icon.ico" />

    <!-- v0.5: Favicon okna — záhlaví (title bar), Taskbar, Alt+Tab (detailnější design) -->
    <Resource Include="Resources\app-favicon.ico" />

    <!-- Jazykové soubory — ResourceDictionary -->
    <Resource Include="Resources\Lang\Strings.en.xaml" />
    <Resource Include="Resources\Lang\Strings.cs.xaml" />

    <!-- v0.5: ResourceDictionary pro témata -->
    <Resource Include="Resources\Themes\CoreStyles.xaml" />
    <Resource Include="Resources\Themes\Theme.Legacy.xaml" />
    <Resource Include="Resources\Themes\Theme.StandardLight.xaml" Condition="'$(BuildProfile)' != 'Lite'" />
    <Resource Include="Resources\Themes\Theme.StandardDark.xaml" Condition="'$(BuildProfile)' != 'Lite'" />
    <Resource Include="Resources\Themes\Theme.ModernDark.xaml" Condition="'$(BuildProfile)' != 'Lite'" />
    <Resource Include="Resources\Themes\Theme.ModernLight.xaml" Condition="'$(BuildProfile)' != 'Lite'" />
    <Resource Include="Resources\Themes\Theme.HighContrast.xaml" Condition="'$(BuildProfile)' != 'Lite'" />
    <Resource Include="Resources\Themes\Theme.CrabCute.xaml" Condition="'$(BuildProfile)' != 'Lite'" />

    <!-- v0.5: Ikony Modern tématu (PNG 48×48, konvertováno ze SVG) -->
    <Resource Include="Resources\Icons\Modern\start.png" Condition="'$(BuildProfile)' != 'Lite'" />
    <Resource Include="Resources\Icons\Modern\stop.png" Condition="'$(BuildProfile)' != 'Lite'" />
    <Resource Include="Resources\Icons\Modern\restart.png" Condition="'$(BuildProfile)' != 'Lite'" />
    <Resource Include="Resources\Icons\Modern\powershell.png" Condition="'$(BuildProfile)' != 'Lite'" />
    <Resource Include="Resources\Icons\Modern\gateway-log.png" Condition="'$(BuildProfile)' != 'Lite'" />
    <Resource Include="Resources\Icons\Modern\cleaning-tool.png" Condition="'$(BuildProfile)' != 'Lite'" />
    <Resource Include="Resources\Icons\Modern\token-manager.png" Condition="'$(BuildProfile)' != 'Lite'" />
    <Resource Include="Resources\Icons\Modern\doctor-fix.png" Condition="'$(BuildProfile)' != 'Lite'" />
    <Resource Include="Resources\Icons\ModernLight\*.png" Condition="'$(BuildProfile)' != 'Lite'" />
    <Resource Include="Resources\Icons\ModernDark\*.png" Condition="'$(BuildProfile)' != 'Lite'" />
    <Resource Include="Resources\Icons\CrabCute\*.png" Condition="'$(BuildProfile)' != 'Lite'" />

    <!-- v1.0: Offline xterm.js assets for embedded terminal -->
    <Resource Include="Resources\Terminal\xterm.min.js" />
    <Resource Include="Resources\Terminal\xterm.min.css" />

    <!-- SVG logo pro dialog O aplikaci — zkopírovat vedle EXE při buildu -->
    <None Include="Resources\app-logo.svg">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>

    <!-- Lokalni uzivatelske manualy pro menu Napoveda (preferujeme lokalni otevreni). -->
    <None Include="Docs\USER_MANUAL*.md">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>Docs\%(Filename)%(Extension)</Link>
    </None>
    <None Include="Docs\USER_MANUAL*.html">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>Docs\%(Filename)%(Extension)</Link>
    </None>

    <!-- v0.5: Splash PNG fallback — embedded resource (graceful degradation když chybí .mp4) -->
    <Resource Include="Resources\splash.png" />

    <!-- Welcome screen UI assets. -->
    <Resource Include="Resources\Welcome\*.png" />

    <!-- Welcome screen theme thumbnails copied beside the EXE for live preview. -->
    <None Include="Resources\ThemePreviews\*.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>

    <!-- v0.5: Splash video — vedle EXE (WMF/MediaElement potřebuje file path) -->
    <None Include="Resources\splash.mp4" Condition="'$(BuildProfile)' != 'Lite'">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>

    <!-- About EasterEgg tools scripts - copied beside the app for prompt commands. -->
    <None Include="Scripts\*.ps1" Condition="'$(BuildProfile)' != 'Lite'">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <!-- Test runner zije vedle aplikace, ale neni soucast WPF buildu. -->
    <Compile Remove="TokenService.Tests\**\*.cs" />
    <Page Remove="TokenService.Tests\**\*.xaml" />
    <EmbeddedResource Remove="TokenService.Tests\**" />
    <None Remove="TokenService.Tests\**" />
  </ItemGroup>

  <ItemGroup>
    <!-- Lokální pracovní výstupy agentů nesmí vstupovat do WPF buildu. -->
    <Compile Remove=".codex\**\*.cs;handoff\**\*.cs;dist\**\*.cs" />
    <Page Remove=".codex\**\*.xaml;handoff\**\*.xaml;dist\**\*.xaml" />
    <EmbeddedResource Remove=".codex\**;handoff\**;dist\**" />
    <None Remove=".codex\**;handoff\**;dist\**" />
  </ItemGroup>

</Project>
