<Window x:Class="OpenClawManager.Views.WelcomeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="OpenClaw Manager Tool by Bloom"
        Width="900"
        Height="900"
        MinWidth="820"
        MinHeight="820"
        WindowStyle="None"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI"
        Background="#160820">

    <Window.Resources>
        <Style x:Key="WelcomeCaptionButton" TargetType="{x:Type Button}">
            <Setter Property="Width" Value="40" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Margin" Value="6,0,0,0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Foreground" Value="#F3F4F6" />
            <Setter Property="Background" Value="#10FFFFFF" />
            <Setter Property="BorderBrush" Value="#24FFFFFF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="12">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#2AFFFFFF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#3AFFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="WelcomeCloseButton" BasedOn="{StaticResource WelcomeCaptionButton}" TargetType="{x:Type Button}" />

        <Style x:Key="LanguageButton" TargetType="{x:Type Button}">
            <Setter Property="Width" Value="42" />
            <Setter Property="Height" Value="42" />
            <Setter Property="Margin" Value="4,0,0,0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="#F3F4F6" />
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10">
                            <Grid>
                                <Border x:Name="HoverWash"
                                        CornerRadius="10"
                                        Background="#30FFFFFF"
                                        Opacity="0" />
                                <Border x:Name="HoverGlass"
                                        CornerRadius="10"
                                        Opacity="0"
                                        IsHitTestVisible="False">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                            <GradientStop Color="#75FFFFFF" Offset="0.00" />
                                            <GradientStop Color="#24FFFFFF" Offset="0.32" />
                                            <GradientStop Color="#00FFFFFF" Offset="0.58" />
                                            <GradientStop Color="#30FFFFFF" Offset="1.00" />
                                        </LinearGradientBrush>
                                    </Border.Background>
                                </Border>
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="BorderBrush" Value="#E6FFFFFF" />
                                <Setter TargetName="HoverWash" Property="Opacity" Value="0.26" />
                                <Setter TargetName="HoverGlass" Property="Opacity" Value="1" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="HoverWash" Property="Opacity" Value="0.14" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="WelcomeCheckBox" TargetType="{x:Type CheckBox}">
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type CheckBox}">
                        <Grid Height="24"
                              SnapsToDevicePixels="True">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="20" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Border x:Name="Box"
                                    Width="14"
                                    Height="14"
                                    CornerRadius="2"
                                    Background="#F6FFFFFF"
                                    BorderBrush="#80FFFFFF"
                                    BorderThickness="1"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center" />
                            <Path x:Name="CheckMark"
                                  Data="M 2 7 L 5.5 10.5 L 12 3"
                                  Stroke="#151515"
                                  StrokeThickness="2"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  StrokeLineJoin="Round"
                                  HorizontalAlignment="Left"
                                  VerticalAlignment="Center"
                                  Margin="1,0,0,0"
                                  Width="13"
                                  Height="12"
                                  Stretch="Uniform"
                                  Visibility="Collapsed" />

                            <ContentPresenter Grid.Column="1"
                                              VerticalAlignment="Center"
                                              RecognizesAccessKey="True"
                                              TextElement.Foreground="{TemplateBinding Foreground}"
                                              TextElement.FontSize="{TemplateBinding FontSize}" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="CheckMark" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Box" Property="BorderBrush" Value="#E6FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="WelcomeThemeItemTemplate">
            <TextBlock Text="{Binding DisplayName}"
                       Foreground="#FFFFFF"
                       FontSize="16"
                       FontWeight="Bold" />
        </DataTemplate>

        <Style x:Key="WelcomeComboBoxItem" TargetType="{x:Type ComboBoxItem}">
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="Padding" Value="14,9" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ComboBoxItem}">
                        <Border x:Name="ItemBorder" Background="Transparent" CornerRadius="9" Margin="4,2">
                            <ContentPresenter VerticalAlignment="Center"
                                              TextElement.Foreground="#FFFFFF"
                                              TextElement.FontSize="16"
                                              TextElement.FontWeight="Bold" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#2EFFFFFF" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#44FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="WelcomeComboBox" TargetType="{x:Type ComboBox}">
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="Background" Value="#24FFFFFF" />
            <Setter Property="BorderBrush" Value="#66FFFFFF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="ItemContainerStyle" Value="{StaticResource WelcomeComboBoxItem}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ComboBox}">
                        <Grid>
                            <Border x:Name="Chrome"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="12" />
                            <TextBlock Margin="14,0,40,0"
                                       VerticalAlignment="Center"
                                       HorizontalAlignment="Left"
                                       Text="{Binding SelectedItem.DisplayName, RelativeSource={RelativeSource TemplatedParent}}"
                                       Foreground="#FFFFFF"
                                       FontSize="16"
                                       FontWeight="Normal"
                                       IsHitTestVisible="False" />
                            <Border Width="26"
                                    Height="24"
                                    CornerRadius="9"
                                    Background="#10FFFFFF"
                                    BorderBrush="#24FFFFFF"
                                    BorderThickness="1"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center"
                                    Margin="0,0,9,0"
                                    IsHitTestVisible="False">
                                <Path Data="M 0 0 L 5 5 L 10 0"
                                      Stroke="#FFFFFF"
                                      StrokeThickness="2"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      StrokeLineJoin="Round"
                                      Width="10"
                                      Height="6"
                                      Stretch="Uniform"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center" />
                            </Border>
                            <ToggleButton Focusable="False"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                          ClickMode="Press">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="{x:Type ToggleButton}">
                                        <Border Background="Transparent" />
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <Popup x:Name="PART_Popup"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   Placement="Bottom"
                                   PopupAnimation="Fade">
                                <Border Width="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                        Margin="0,6,0,0"
                                        Padding="4"
                                        CornerRadius="12"
                                        Background="#D331174E"
                                        BorderBrush="#66FFFFFF"
                                        BorderThickness="1">
                                    <ScrollViewer CanContentScroll="True">
                                        <ItemsPresenter />
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#33FFFFFF" />
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="#88FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Background="#160820">
        <Grid ClipToBounds="True" MouseLeftButtonDown="WindowChrome_MouseLeftButtonDown">
            <Image x:Name="SplashFallback"
                   Source="pack://application:,,,/Resources/splash.png"
                   Stretch="UniformToFill"
                   ImageFailed="SplashFallback_ImageFailed" />

            <MediaElement x:Name="SplashVideo"
                          Stretch="UniformToFill"
                          LoadedBehavior="Manual"
                          UnloadedBehavior="Stop"
                          Visibility="Collapsed"
                          MediaEnded="SplashVideo_MediaEnded"
                          MediaFailed="SplashVideo_MediaFailed" />

            <Rectangle IsHitTestVisible="False">
                <Rectangle.Fill>
                    <RadialGradientBrush Center="0.5,0.35" GradientOrigin="0.5,0.28" RadiusX="0.86" RadiusY="0.82">
                        <GradientStop Color="#184C247E" Offset="0.0" />
                        <GradientStop Color="#704C247E" Offset="0.58" />
                        <GradientStop Color="#D6150A2A" Offset="1.0" />
                    </RadialGradientBrush>
                </Rectangle.Fill>
            </Rectangle>

            <Grid Height="56" VerticalAlignment="Top" Margin="16,10,10,0">
                <Button HorizontalAlignment="Left"
                        Style="{StaticResource WelcomeCaptionButton}"
                        Click="ReplaySplash_Click"
                        ToolTip="Replay splash">
                    <Path Data="M 0 0 L 0 12 L 10 6 Z"
                          Fill="#F3F4F6"
                          Width="10"
                          Height="12"
                          Stretch="Uniform" />
                </Button>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Style="{StaticResource WelcomeCaptionButton}"
                            Click="Minimize_Click">
                        <Path Data="M 0 0 L 12 0"
                              Stroke="#F3F4F6"
                              StrokeThickness="2"
                              StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round"
                              Width="12"
                              Height="2"
                              Stretch="Uniform" />
                    </Button>
                    <Button Style="{StaticResource WelcomeCloseButton}"
                            Click="Close_Click">
                        <Path Data="M 0 0 L 10 10 M 10 0 L 0 10"
                              Stroke="#F3F4F6"
                              StrokeThickness="2"
                              StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round"
                              Width="10"
                              Height="10"
                              Stretch="Uniform" />
                    </Button>
                </StackPanel>
            </Grid>

            <Border Width="640"
                    Padding="34,30,34,24"
                    CornerRadius="30"
                    BorderBrush="#33FFFFFF"
                    BorderThickness="1"
                    Background="#8A33174E"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Bottom"
                    Margin="0,0,0,66">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="56"
                                      ShadowDepth="18"
                                      Direction="270"
                                      Opacity="0.56"
                                      Color="#000000" />
                </Border.Effect>

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="22" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="16" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="18" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="12" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="12" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Height="42">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Border Width="42" Height="42" CornerRadius="12" Background="Transparent" BorderBrush="Transparent" BorderThickness="0" ClipToBounds="True">
                            <Image Source="pack://application:,,,/Resources/Welcome/logo-crab_teal_solid.png"
                                   Stretch="Uniform" />
                        </Border>

                        <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="OpenClaw Manager Tool"
                                       Foreground="#FFFFFF"
                                       FontSize="20"
                                       FontWeight="Bold"
                                       LineHeight="24" />
                            <TextBlock x:Name="WelcomeSubtitleText"
                                       Foreground="#FFFFFF"
                                       FontSize="16"
                                       FontWeight="Normal"
                                       LineHeight="18"
                                       Margin="0,1,0,0" />
                        </StackPanel>

                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button x:Name="LanguageCsButton" Style="{StaticResource LanguageButton}" Click="LanguageCs_Click">
                                <Image Source="pack://application:,,,/Resources/Welcome/flag-cz_solid.png" Stretch="Uniform" />
                            </Button>
                            <Button x:Name="LanguageEnButton" Style="{StaticResource LanguageButton}" Click="LanguageEn_Click">
                                <Image Source="pack://application:,,,/Resources/Welcome/flag-en_solid.png" Stretch="Uniform" />
                            </Button>
                        </StackPanel>
                    </Grid>

                    <StackPanel Grid.Row="2">
                        <TextBlock x:Name="ThemeLabelText"
                                   Foreground="#FFFFFF"
                                   FontSize="16"
                                   FontWeight="Normal"
                                   Margin="0,0,0,8" />
                        <ComboBox x:Name="ThemeCombo"
                                  Style="{StaticResource WelcomeComboBox}"
                                  Height="42"
                                  ItemTemplate="{StaticResource WelcomeThemeItemTemplate}"
                                  TextSearch.TextPath="DisplayName"
                                  SelectionChanged="ThemeCombo_SelectionChanged" />
                    </StackPanel>

                    <Border Grid.Row="4"
                            Height="320"
                            CornerRadius="18"
                            BorderBrush="#2BFFFFFF"
                            BorderThickness="1"
                            Background="#AA0A0A0F"
                            ClipToBounds="True">
                        <Grid>
                            <Image x:Name="ThemePreviewImage"
                                   Stretch="UniformToFill"
                                   Visibility="Collapsed" />
                            <Grid x:Name="ThemePreviewPlaceholder">
                                <Grid.Background>
                                    <RadialGradientBrush Center="0.5,0.5" GradientOrigin="0.5,0.5" RadiusX="0.82" RadiusY="0.82">
                                        <GradientStop Color="#2D1A4A" Offset="0" />
                                        <GradientStop Color="#0A0A0F" Offset="1" />
                                    </RadialGradientBrush>
                                </Grid.Background>
                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                    <TextBlock x:Name="ThemePreviewName"
                                               Foreground="#FFFFFF"
                                               FontSize="16"
                                               FontWeight="Normal"
                                               HorizontalAlignment="Center" />
                                    <TextBlock x:Name="ThemePreviewCaption"
                                               Foreground="#FFFFFF"
                                               FontSize="16"
                                               HorizontalAlignment="Center"
                                               Margin="0,8,0,0" />
                                </StackPanel>
                            </Grid>
                            <Border VerticalAlignment="Bottom" Padding="14,20,14,12">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="#00000000" Offset="0" />
                                        <GradientStop Color="#C8000000" Offset="1" />
                                    </LinearGradientBrush>
                                </Border.Background>
                                <DockPanel>
                                    <TextBlock x:Name="ThemePreviewFooter"
                                               DockPanel.Dock="Left"
                                               Foreground="#FFFFFF"
                                               FontWeight="Normal"
                                               FontSize="16" />
                                    <TextBlock Text="preview"
                                               Foreground="#FFFFFF"
                                               HorizontalAlignment="Right"
                                               FontSize="16" />
                                </DockPanel>
                            </Border>
                        </Grid>
                    </Border>

                    <CheckBox Grid.Row="6"
                              x:Name="AutoUpdateCheckBox"
                              Style="{StaticResource WelcomeCheckBox}"
                              Foreground="#FFFFFF"
                              VerticalAlignment="Center"
                              VerticalContentAlignment="Center"
                              IsChecked="False">
                        <TextBlock x:Name="AutoUpdateText"
                                   Foreground="#FFFFFF"
                                   FontSize="16"
                                   VerticalAlignment="Center" />
                    </CheckBox>

                    <Button Grid.Row="8"
                            x:Name="ContinueButton"
                            Height="58"
                            Click="Continue_Click"
                            Foreground="#FFFFFF"
                            FocusVisualStyle="{x:Null}">
                        <Button.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Color="#78B8FF" Offset="0" />
                                <GradientStop Color="#2F72EA" Offset="0.50" />
                                <GradientStop Color="#1D55D3" Offset="1" />
                            </LinearGradientBrush>
                        </Button.Background>
                        <Button.Template>
                            <ControlTemplate TargetType="{x:Type Button}">
                                <Border x:Name="ButtonChrome"
                                        CornerRadius="16"
                                        BorderBrush="#88D6E7FF"
                                        BorderThickness="1"
                                        Background="{TemplateBinding Background}"
                                        RenderTransformOrigin="0.5,0.5">
                                    <Border.RenderTransform>
                                        <TranslateTransform />
                                    </Border.RenderTransform>
                                    <Grid>
                                        <Border x:Name="HoverWash"
                                                CornerRadius="16"
                                                Background="#30FFFFFF"
                                                Opacity="0" />
                                        <Border Height="21"
                                                VerticalAlignment="Top"
                                                CornerRadius="16,16,0,0"
                                                Background="#28FFFFFF" />
                                        <Border x:Name="HoverGlass"
                                                CornerRadius="16"
                                                Opacity="0"
                                                IsHitTestVisible="False">
                                            <Border.Background>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                    <GradientStop Color="#75FFFFFF" Offset="0.00" />
                                                    <GradientStop Color="#24FFFFFF" Offset="0.32" />
                                                    <GradientStop Color="#00FFFFFF" Offset="0.58" />
                                                    <GradientStop Color="#30FFFFFF" Offset="1.00" />
                                                </LinearGradientBrush>
                                            </Border.Background>
                                        </Border>
                                        <Grid HorizontalAlignment="Center"
                                              VerticalAlignment="Center">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="20" />
                                                <ColumnDefinition Width="12" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Viewbox Width="12"
                                                     Height="12"
                                                     VerticalAlignment="Center"
                                                     HorizontalAlignment="Center">
                                                <Path Data="M 0 0 L 0 10 L 8 5 Z"
                                                      Fill="#FFFFFF"
                                                      Stretch="Uniform" />
                                            </Viewbox>
                                            <TextBlock Text="{TemplateBinding Content}"
                                                       Grid.Column="2"
                                                       Foreground="{TemplateBinding Foreground}"
                                                       FontSize="20"
                                                       FontWeight="Normal"
                                                       LineHeight="24"
                                                       VerticalAlignment="Center" />
                                        </Grid>
                                    </Grid>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="ButtonChrome" Property="BorderBrush" Value="#E6FFFFFF" />
                                        <Setter TargetName="HoverWash" Property="Opacity" Value="0.26" />
                                        <Setter TargetName="HoverGlass" Property="Opacity" Value="1" />
                                    </Trigger>
                                    <Trigger Property="IsPressed" Value="True">
                                        <Setter TargetName="ButtonChrome" Property="Opacity" Value="0.90" />
                                        <Setter TargetName="HoverWash" Property="Opacity" Value="0.14" />
                                        <Setter TargetName="ButtonChrome" Property="RenderTransform">
                                            <Setter.Value>
                                                <TranslateTransform Y="1" />
                                            </Setter.Value>
                                        </Setter>
                                    </Trigger>
                                    <Trigger Property="IsEnabled" Value="False">
                                        <Setter TargetName="ButtonChrome" Property="Opacity" Value="0.5" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <DockPanel Grid.Row="10" LastChildFill="False" Margin="0,12,0,0">
                        <TextBlock x:Name="FooterVersionText"
                                   DockPanel.Dock="Left"
                                   Foreground="#C8C7D8"
                                   FontSize="11" />
                        <Button x:Name="HelpButton"
                                DockPanel.Dock="Right"
                                Background="Transparent"
                                BorderBrush="Transparent"
                                Foreground="#C8C7D8"
                                Padding="0"
                                Cursor="Hand"
                                FocusVisualStyle="{x:Null}"
                                Click="HelpButton_Click">
                            <TextBlock x:Name="HelpText"
                                       Foreground="#C8C7D8"
                                       FontSize="11" />
                        </Button>
                    </DockPanel>

                    <TextBlock x:Name="DpapiWarningText"
                               Grid.Row="10"
                               Visibility="Collapsed" />
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>

