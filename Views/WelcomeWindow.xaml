<Window x:Class="OpenClawManager.Views.WelcomeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="OpenClaw Manager Tool"
        Width="960"
        Height="640"
        MinWidth="900"
        MinHeight="600"
        WindowStyle="None"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="#0B0C10">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

        <Style x:Key="WelcomeCaptionButton" TargetType="{x:Type Button}">
            <Setter Property="Width" Value="44" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Margin" Value="4,0,0,0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Foreground" Value="#E7E9EE" />
            <Setter Property="Background" Value="#0FFFFFFF" />
            <Setter Property="BorderBrush" Value="#33FFFFFF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#1FFFFFFF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#0AFFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="WelcomeCloseCaptionButton"
               TargetType="{x:Type Button}"
               BasedOn="{StaticResource WelcomeCaptionButton}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#D9EF4444" />
                                <Setter TargetName="Root" Property="BorderBrush" Value="#D9EF4444" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#AAEF4444" />
                                <Setter TargetName="Root" Property="BorderBrush" Value="#AAEF4444" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="WelcomeLaunchButtonStyle" TargetType="{x:Type Button}">
            <Setter Property="Foreground" Value="#F3F4F6" />
            <Setter Property="FontSize" Value="18" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                CornerRadius="18"
                                SnapsToDevicePixels="True">
                            <Grid>
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                <Border x:Name="Gloss"
                                        Height="28"
                                        VerticalAlignment="Top"
                                        CornerRadius="18,18,0,0"
                                        IsHitTestVisible="False">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                            <GradientStop Color="#0DFFFFFF" Offset="0" />
                                            <GradientStop Color="#00FFFFFF" Offset="1" />
                                        </LinearGradientBrush>
                                    </Border.Background>
                                </Border>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Opacity" Value="0.92" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Opacity" Value="0.84" />
                                <Setter TargetName="Root" Property="RenderTransform">
                                    <Setter.Value>
                                        <TranslateTransform Y="1" />
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Background="#0B0C10">
        <Grid ClipToBounds="True">
            <Image x:Name="SplashFallback"
                   Source="pack://application:,,,/Resources/splash.png"
                   Stretch="UniformToFill"
                   ImageFailed="SplashFallback_ImageFailed" />

            <MediaElement x:Name="SplashVideo"
                          Stretch="UniformToFill"
                          LoadedBehavior="Manual"
                          UnloadedBehavior="Stop"
                          Visibility="Collapsed"
                          MediaEnded="SplashVideo_MediaEnded"
                          MediaFailed="SplashVideo_MediaFailed" />

            <Rectangle>
                <Rectangle.Fill>
                    <RadialGradientBrush Center="0.5,0.42" GradientOrigin="0.5,0.42" RadiusX="0.78" RadiusY="0.70">
                        <GradientStop Color="#00000000" Offset="0.0" />
                        <GradientStop Color="#66000000" Offset="0.72" />
                        <GradientStop Color="#CC000000" Offset="1.0" />
                    </RadialGradientBrush>
                </Rectangle.Fill>
            </Rectangle>

            <Grid MouseLeftButtonDown="WindowChrome_MouseLeftButtonDown">
                <Grid.RowDefinitions>
                    <RowDefinition Height="56" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <DockPanel Grid.Row="0" Margin="18,12,18,0">
                    <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="32"
                                Height="32"
                                CornerRadius="8"
                                Background="{DynamicResource Theme.Brush.Accent}"
                                BorderBrush="#55FFFFFF"
                                BorderThickness="1">
                            <Path Data="M 10 22 L 16 8 L 22 22 M 12.5 17.5 L 19.5 17.5"
                                  Stroke="#F3F4F6"
                                  StrokeThickness="2"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  StrokeLineJoin="Round"
                                  Stretch="Uniform"
                                  Margin="7" />
                        </Border>
                        <TextBlock Text="OpenClaw Manager Tool"
                                   Foreground="#E7E9EE"
                                   FontSize="15"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center"
                                   Margin="10,0,0,0" />
                    </StackPanel>

                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button Content="_"
                                Style="{StaticResource WelcomeCaptionButton}"
                                Click="Minimize_Click" />
                        <Button Content="X"
                                Style="{StaticResource WelcomeCloseCaptionButton}"
                                Click="Close_Click" />
                    </StackPanel>
                </DockPanel>

                <Border Grid.Row="1"
                        Width="720"
                        MaxWidth="760"
                        Padding="38,34,38,32"
                        CornerRadius="28"
                        BorderBrush="#2EFFFFFF"
                        BorderThickness="1"
                        Background="#A60A0C12"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="48"
                                          ShadowDepth="18"
                                          Direction="270"
                                          Opacity="0.58"
                                          Color="#000000" />
                    </Border.Effect>

                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="22" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="22" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel>
                                <TextBlock Text="Prvni spusteni"
                                           Foreground="#9AA1AC"
                                           FontSize="12"
                                           FontWeight="Bold"
                                           TextOptions.TextFormattingMode="Display" />
                                <TextBlock Text="Vyber vzhled pro OpenClaw"
                                           Foreground="#F3F4F6"
                                           FontSize="28"
                                           FontWeight="Bold"
                                           Margin="0,6,0,0" />
                                <TextBlock Text="Nastaveni se ulozi az po spusteni aplikace."
                                           Foreground="#B8BDC7"
                                           FontSize="14"
                                           Margin="0,8,0,0" />
                            </StackPanel>

                            <Border Grid.Column="1"
                                    Padding="12,6"
                                    CornerRadius="14"
                                    BorderBrush="#2AFFFFFF"
                                    BorderThickness="1"
                                    Background="#66000000"
                                    VerticalAlignment="Top">
                                <TextBlock x:Name="SettingsModeText"
                                           Foreground="#C4CAD4"
                                           FontSize="12"
                                           FontFamily="Consolas" />
                            </Border>
                        </Grid>

                        <Grid Grid.Row="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="290" />
                                <ColumnDefinition Width="24" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="TEMA"
                                           Foreground="#9AA1AC"
                                           FontSize="12"
                                           FontWeight="Bold"
                                           Margin="0,0,0,10" />
                                <ComboBox x:Name="ThemeCombo"
                                          Height="42"
                                          DisplayMemberPath="DisplayName"
                                          SelectionChanged="ThemeCombo_SelectionChanged" />

                                <CheckBox x:Name="AutoUpdateCheckBox"
                                          Content="Kontrolovat aktualizace pri startu"
                                          Foreground="#E7E9EE"
                                          Margin="0,18,0,0"
                                          IsChecked="False" />

                                <Border Margin="0,18,0,0"
                                        Padding="14"
                                        CornerRadius="14"
                                        Background="#3A000000"
                                        BorderBrush="#24FFFFFF"
                                        BorderThickness="1">
                                    <StackPanel>
                                        <TextBlock Text="DPAPI"
                                                   Foreground="#FBBF24"
                                                   FontSize="12"
                                                   FontWeight="Bold" />
                                        <TextBlock x:Name="DpapiWarningText"
                                                   TextWrapping="Wrap"
                                                   Foreground="#D5DAE3"
                                                   FontSize="12"
                                                   LineHeight="17"
                                                   Margin="0,6,0,0" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <Border Grid.Column="2"
                                    CornerRadius="18"
                                    BorderBrush="#29FFFFFF"
                                    BorderThickness="1"
                                    Background="#C20A0C12"
                                    ClipToBounds="True">
                                <Grid>
                                    <Image x:Name="ThemePreviewImage"
                                           Stretch="UniformToFill"
                                           Visibility="Collapsed" />
                                    <Grid x:Name="ThemePreviewPlaceholder">
                                        <Grid.Background>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                <GradientStop Color="#20242D" Offset="0" />
                                                <GradientStop Color="#0A0C12" Offset="1" />
                                            </LinearGradientBrush>
                                        </Grid.Background>
                                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                            <TextBlock x:Name="ThemePreviewName"
                                                       Foreground="#F3F4F6"
                                                       FontSize="24"
                                                       FontWeight="Bold"
                                                       HorizontalAlignment="Center" />
                                            <TextBlock x:Name="ThemePreviewCaption"
                                                       Foreground="#9AA1AC"
                                                       FontSize="12"
                                                       FontFamily="Consolas"
                                                       HorizontalAlignment="Center"
                                                       Margin="0,8,0,0" />
                                        </StackPanel>
                                    </Grid>
                                    <Border VerticalAlignment="Bottom"
                                            Padding="14,18,14,12">
                                        <Border.Background>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                <GradientStop Color="#00000000" Offset="0" />
                                                <GradientStop Color="#B8000000" Offset="1" />
                                            </LinearGradientBrush>
                                        </Border.Background>
                                        <DockPanel>
                                            <TextBlock x:Name="ThemePreviewFooter"
                                                       DockPanel.Dock="Left"
                                                       Foreground="#E7E9EE"
                                                       FontFamily="Consolas"
                                                       FontWeight="SemiBold"
                                                       FontSize="12" />
                                            <TextBlock Text="preview"
                                                       Foreground="#88FFFFFF"
                                                       HorizontalAlignment="Right"
                                                       FontSize="12" />
                                        </DockPanel>
                                    </Border>
                                </Grid>
                            </Border>
                        </Grid>

                        <Button Grid.Row="4"
                                x:Name="ContinueButton"
                                Height="62"
                                Content="Spustit aplikaci"
                                Style="{StaticResource WelcomeLaunchButtonStyle}"
                                Click="Continue_Click"
                                Background="{DynamicResource Theme.Brush.Accent}" />
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>
