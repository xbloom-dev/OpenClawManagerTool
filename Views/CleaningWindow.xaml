<Window x:Class="OpenClawManager.Views.CleaningWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Vyčistit soubory"
        Height="700" Width="780"
        MinHeight="550" MinWidth="600"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize">

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Kroky čištění -->
        <GroupBox Grid.Row="0" Header="Kroky čištění" Padding="8" Margin="0,0,0,8">
            <StackPanel>
                <CheckBox x:Name="ChkStep1" IsChecked="True" Margin="0,3">
                    <TextBlock>
                        <Run Text="[1]" FontWeight="Bold"/>
                        <Run Text=" Staré logy"/>
                        <Run Text=" — Gateway log soubory starší než dnešek" Foreground="Gray"/>
                    </TextBlock>
                </CheckBox>
                <CheckBox x:Name="ChkStep2" IsChecked="True" Margin="0,3">
                    <TextBlock>
                        <Run Text="[2]" FontWeight="Bold"/>
                        <Run Text=" Zálohy konfigurace"/>
                        <Run Text=" — openclaw.json.bak* (ponechat 2 nejnovější)" Foreground="Gray"/>
                    </TextBlock>
                </CheckBox>
                <CheckBox x:Name="ChkStep3" IsChecked="False" Margin="0,3">
                    <TextBlock>
                        <Run Text="[3]" FontWeight="Bold"/>
                        <Run Text=" Stability reporty"/>
                        <Run Text=" — logs/stability/ starší než 3 dny" Foreground="Gray"/>
                        <Run Text=" (opt-in)" FontStyle="Italic" Foreground="DarkGray"/>
                    </TextBlock>
                </CheckBox>
                <CheckBox x:Name="ChkStep4" IsChecked="True" Margin="0,3">
                    <TextBlock>
                        <Run Text="[4]" FontWeight="Bold"/>
                        <Run Text=" Browser cache"/>
                        <Run Text=" — browser-data/ starší než 1 den" Foreground="Gray"/>
                    </TextBlock>
                </CheckBox>
                <CheckBox x:Name="ChkStep5" IsChecked="True" Margin="0,3">
                    <TextBlock>
                        <Run Text="[5]" FontWeight="Bold"/>
                        <Run Text=" Session locky"/>
                        <Run Text=" — všechny *.lock v agents/*/sessions/" Foreground="Gray"/>
                    </TextBlock>
                </CheckBox>

                <!-- Krok 6 s integrovaným sliderem -->
                <Grid Margin="0,3">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <CheckBox Grid.Column="0" x:Name="ChkStep6" IsChecked="True" VerticalAlignment="Center">
                        <TextBlock>
                            <Run Text="[6]" FontWeight="Bold"/>
                            <Run Text=" sessions.json"/>
                            <Run Text=" — zachovat:" Foreground="Gray"/>
                        </TextBlock>
                    </CheckBox>
                    <Slider Grid.Column="1" x:Name="SliderKeep"
                            Minimum="1" Maximum="50" Value="10"
                            IsSnapToTickEnabled="True" TickFrequency="1"
                            Margin="8,0,8,0" VerticalAlignment="Center"
                            IsEnabled="{Binding IsChecked, ElementName=ChkStep6}" />
                    <TextBlock Grid.Column="2"
                               Text="{Binding Value, ElementName=SliderKeep, StringFormat={}{0:0}}"
                               FontWeight="Bold" MinWidth="24" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="3"
                               Text=" sessions/agent" Foreground="Gray" VerticalAlignment="Center" />
                </Grid>

                <!-- Krok 7 — Token Manager zálohy (opt-in, výchozí vypnuto) -->
                <CheckBox x:Name="ChkStep7" IsChecked="False" Margin="0,3">
                    <TextBlock>
                        <Run Text="[7]" FontWeight="Bold"/>
                        <Run Text=" Token Manager zálohy"/>
                        <Run Text=" — *.bak soubory v Token Manager složce" Foreground="Gray"/>
                        <Run Text=" (opt-in)" FontStyle="Italic" Foreground="DarkGray"/>
                    </TextBlock>
                </CheckBox>
            </StackPanel>
        </GroupBox>

        <!-- OpenClaw Gateway sekce -->
        <GroupBox Grid.Row="1" Header="OpenClaw Gateway" Padding="8" Margin="0,0,0,8">
            <StackPanel>
                <!-- Scheduled Task -->
                <CheckBox x:Name="ChkManageTask" IsChecked="True" Margin="0,3">
                    <TextBlock>
                        <Run Text="Dočasně vypnout Scheduled Task 'OpenClaw Gateway'" />
                        <Run Text=" během cleanupu" Foreground="Gray" />
                    </TextBlock>
                </CheckBox>
                <TextBlock x:Name="TxtTaskStatus"
                           Foreground="Gray" FontSize="11"
                           Margin="20,1,0,6" />

                <!-- Zastavit Gateway -->
                <CheckBox x:Name="ChkStopGateway" IsChecked="False" Margin="0,3">
                    <TextBlock>
                        <Run Text="Zastavit běžící Gateway" />
                        <Run Text=" před cleanupem" Foreground="Gray" />
                    </TextBlock>
                </CheckBox>

                <!-- Zavřít všechna okna — aktivní jen pokud je zaškrtnutý ChkStopGateway -->
                <CheckBox x:Name="ChkCloseAll" IsChecked="False" Margin="20,3,0,0"
                          IsEnabled="{Binding IsChecked, ElementName=ChkStopGateway}">
                    <TextBlock>
                        <Run Text="Zavřít všechna OpenClaw okna" />
                        <Run Text=" (embedded TUI + PowerShell wrappery)" Foreground="Gray" />
                    </TextBlock>
                </CheckBox>
            </StackPanel>
        </GroupBox>

        <!-- Log výstupů -->
        <GroupBox Grid.Row="2" Header="Průběh / Log" Padding="4" Margin="0,0,0,8">
            <TextBox x:Name="TxtLog"
                     IsReadOnly="True"
                     FontFamily="Consolas"
                     FontSize="11"
                     Background="#1E1E1E"
                     Foreground="#DCDCDC"
                     VerticalScrollBarVisibility="Auto"
                     HorizontalScrollBarVisibility="Auto"
                     TextWrapping="NoWrap"
                     Padding="6" />
        </GroupBox>

        <!-- Souhrn -->
        <Border Grid.Row="3" Padding="8,6" Margin="0,0,0,8"
                BorderBrush="LightGray" BorderThickness="1" CornerRadius="2">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" x:Name="TxtSummary" Text="Připraveno." VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" x:Name="TxtSummarySize" Text="" FontWeight="Bold" VerticalAlignment="Center" />
            </Grid>
        </Border>

        <!-- Tlačítka -->
        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="BtnDryRun" Content="Náhled"
                    Background="{DynamicResource Brush.ActionUtility}"
                    Width="100" Height="28" Margin="4,0"
                    ToolTip="Zobrazí co by se smazalo, nic nemaže." />
            <Button x:Name="BtnRun" Content="Spustit"
                    Width="100" Height="28" Margin="4,0"
                    Background="{DynamicResource Brush.ActionPositive}"
                    ToolTip="POZOR: Trvale smaže vybrané soubory. Akci nelze vrátit" />
            <Button x:Name="BtnClose" Content="Zavřít"
                    Width="80" Height="28" Margin="4,0"
                    Background="{DynamicResource Brush.ActionDanger}"
                    ToolTip="Zavře Cleaning Tool."
                    IsCancel="True" />
        </StackPanel>
    </Grid>
</Window>
