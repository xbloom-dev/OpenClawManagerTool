<Window x:Class="OpenClawManager.Views.CleaningWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="OpenClaw Manager — Cleaning Tool"
        Height="580" Width="720"
        MinHeight="450" MinWidth="580"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize">

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />  <!-- Kroky -->
            <RowDefinition Height="*" />     <!-- Log -->
            <RowDefinition Height="Auto" />  <!-- Souhrn -->
            <RowDefinition Height="Auto" />  <!-- Tlačítka -->
        </Grid.RowDefinitions>

        <!-- Kroky čištění -->
        <GroupBox Grid.Row="0" Header="Kroky čištění" Padding="8" Margin="0,0,0,8">
            <StackPanel>
                <CheckBox x:Name="ChkStep1" IsChecked="True" Margin="0,3">
                    <TextBlock>
                        <Run Text="[1]" FontWeight="Bold"/>
                        <Run Text=" Staré logy"/>
                        <Run Text=" — Gateway log soubory starší než dnešek" Foreground="Gray"/>
                    </TextBlock>
                </CheckBox>
                <CheckBox x:Name="ChkStep2" IsChecked="True" Margin="0,3">
                    <TextBlock>
                        <Run Text="[2]" FontWeight="Bold"/>
                        <Run Text=" Zálohy konfigurace"/>
                        <Run Text=" — openclaw.json.bak* (ponechat 2 nejnovější)" Foreground="Gray"/>
                    </TextBlock>
                </CheckBox>
                <CheckBox x:Name="ChkStep3" IsChecked="False" Margin="0,3">
                    <TextBlock>
                        <Run Text="[3]" FontWeight="Bold"/>
                        <Run Text=" Stability reporty"/>
                        <Run Text=" — logs/stability/ starší než 3 dny" Foreground="Gray"/>
                        <Run Text=" (opt-in)" FontStyle="Italic" Foreground="DarkGray"/>
                    </TextBlock>
                </CheckBox>
                <CheckBox x:Name="ChkStep4" IsChecked="True" Margin="0,3">
                    <TextBlock>
                        <Run Text="[4]" FontWeight="Bold"/>
                        <Run Text=" Browser cache"/>
                        <Run Text=" — browser-data/ starší než 1 den" Foreground="Gray"/>
                    </TextBlock>
                </CheckBox>
                <CheckBox x:Name="ChkStep5" IsChecked="True" Margin="0,3">
                    <TextBlock>
                        <Run Text="[5]" FontWeight="Bold"/>
                        <Run Text=" Session locky"/>
                        <Run Text=" — všechny *.lock v agents/*/sessions/" Foreground="Gray"/>
                    </TextBlock>
                </CheckBox>
                <CheckBox IsEnabled="False" IsChecked="False" Margin="0,3">
                    <TextBlock>
                        <Run Text="[6]" FontWeight="Bold"/>
                        <Run Text=" sessions.json cleanup"/>
                        <Run Text=" — Coming in v0.3+" FontStyle="Italic" Foreground="DarkGray"/>
                    </TextBlock>
                </CheckBox>
            </StackPanel>
        </GroupBox>

        <!-- Log výstupů -->
        <GroupBox Grid.Row="1" Header="Průběh / Log" Padding="4" Margin="0,0,0,8">
            <TextBox x:Name="TxtLog"
                     IsReadOnly="True"
                     FontFamily="Consolas"
                     FontSize="11"
                     Background="#1E1E1E"
                     Foreground="#DCDCDC"
                     VerticalScrollBarVisibility="Auto"
                     HorizontalScrollBarVisibility="Auto"
                     TextWrapping="NoWrap"
                     Padding="6" />
        </GroupBox>

        <!-- Souhrn -->
        <Border Grid.Row="2" Padding="8,6" Margin="0,0,0,8"
                BorderBrush="LightGray" BorderThickness="1" CornerRadius="2">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" x:Name="TxtSummary" Text="Připraveno." VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" x:Name="TxtSummarySize" Text="" FontWeight="Bold" VerticalAlignment="Center" />
            </Grid>
        </Border>

        <!-- Tlačítka -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="BtnDryRun" Content="Dry-run"
                    Width="100" Height="28" Margin="4,0"
                    ToolTip="Spočítá co by smazal, ale nic neudělá" />
            <Button x:Name="BtnRun" Content="Spustit"
                    Width="100" Height="28" Margin="4,0"
                    Background="#FFD0D0"
                    ToolTip="POZOR: Trvale smaže vybrané soubory" />
            <Button x:Name="BtnClose" Content="Zavřít"
                    Width="80" Height="28" Margin="4,0"
                    IsCancel="True" />
        </StackPanel>

    </Grid>
</Window>
