<Window x:Class="OpenClawManager.Views.CleaningWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding WindowTitle}"
        Height="700" Width="780"
        MinHeight="550" MinWidth="600"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize">

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <GroupBox Grid.Row="0" Header="{Binding StepsHeader}" Padding="8" Margin="0,0,0,8">
            <StackPanel IsEnabled="{Binding AreOptionsEnabled}">
                <CheckBox Content="{Binding Step1Text}" IsChecked="{Binding IsStep1Selected, Mode=TwoWay}" Margin="0,3" />
                <CheckBox Content="{Binding Step2Text}" IsChecked="{Binding IsStep2Selected, Mode=TwoWay}" Margin="0,3" />
                <CheckBox Content="{Binding Step3Text}" IsChecked="{Binding IsStep3Selected, Mode=TwoWay}" Margin="0,3" />
                <CheckBox Content="{Binding Step4Text}" IsChecked="{Binding IsStep4Selected, Mode=TwoWay}" Margin="0,3" />
                <CheckBox Content="{Binding Step5Text}" IsChecked="{Binding IsStep5Selected, Mode=TwoWay}" Margin="0,3" />

                <Grid Margin="0,3">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <CheckBox Grid.Column="0"
                              Content="{Binding Step6Text}"
                              IsChecked="{Binding IsStep6Selected, Mode=TwoWay}"
                              VerticalAlignment="Center" />
                    <Slider Grid.Column="1"
                            Minimum="1" Maximum="50"
                            Value="{Binding KeepSessions, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            IsSnapToTickEnabled="True"
                            TickFrequency="1"
                            Margin="8,0,8,0"
                            VerticalAlignment="Center"
                            IsEnabled="{Binding IsKeepSessionsEnabled}" />
                    <TextBlock Grid.Column="2"
                               Text="{Binding KeepSessions}"
                               FontWeight="Bold"
                               MinWidth="24"
                               VerticalAlignment="Center" />
                    <TextBlock Grid.Column="3"
                               Text="{Binding SessionsPerAgentText}"
                               Foreground="Gray"
                               VerticalAlignment="Center" />
                </Grid>

                <CheckBox Content="{Binding Step7Text}" IsChecked="{Binding IsStep7Selected, Mode=TwoWay}" Margin="0,3" />
            </StackPanel>
        </GroupBox>

        <GroupBox Grid.Row="1" Header="{Binding GatewayHeader}" Padding="8" Margin="0,0,0,8">
            <StackPanel>
                <CheckBox Content="{Binding ManageTaskText}"
                          IsChecked="{Binding IsManageTaskSelected, Mode=TwoWay}"
                          IsEnabled="{Binding IsManageTaskEnabled}"
                          Margin="0,3" />
                <TextBlock Text="{Binding TaskStatus}"
                           Foreground="Gray" FontSize="11"
                           Margin="20,1,0,6" />

                <CheckBox Content="{Binding StopGatewayText}"
                          IsChecked="{Binding IsStopGatewaySelected, Mode=TwoWay}"
                          IsEnabled="{Binding AreOptionsEnabled}"
                          Margin="0,3" />

                <CheckBox Content="{Binding CloseAllText}"
                          IsChecked="{Binding IsCloseAllSelected, Mode=TwoWay}"
                          IsEnabled="{Binding IsCloseAllEnabled}"
                          Margin="20,3,0,0" />
            </StackPanel>
        </GroupBox>

        <GroupBox Grid.Row="2" Header="{Binding LogHeader}" Padding="4" Margin="0,0,0,8">
            <TextBox x:Name="TxtLog"
                     IsReadOnly="True"
                     FontFamily="Consolas"
                     FontSize="11"
                     Background="{DynamicResource Theme.Brush.OutputBackground}"
                     Foreground="{DynamicResource Theme.Brush.OutputText}"
                     VerticalScrollBarVisibility="Auto"
                     HorizontalScrollBarVisibility="Auto"
                     TextWrapping="NoWrap"
                     Padding="6" />
        </GroupBox>

        <Border Grid.Row="3" Padding="8,6" Margin="0,0,0,8"
                BorderBrush="LightGray" BorderThickness="1" CornerRadius="2">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{Binding Summary}" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Text="{Binding SummarySize}" FontWeight="Bold" VerticalAlignment="Center" />
            </Grid>
        </Border>

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="{Binding DryRunText}"
                    Command="{Binding DryRunCommand}"
                    Background="{DynamicResource Brush.ActionUtility}"
                    Width="100" Height="28" Margin="4,0"
                    ToolTip="{Binding DryRunToolTip}" />
            <Button Content="{Binding RunText}"
                    Command="{Binding RunCleanupCommand}"
                    Width="100" Height="28" Margin="4,0"
                    Background="{DynamicResource Brush.ActionPositive}"
                    ToolTip="{Binding RunToolTip}" />
            <Button Content="{Binding CloseText}"
                    Command="{Binding CloseCommand}"
                    Width="80" Height="28" Margin="4,0"
                    Background="{DynamicResource Brush.ActionDanger}"
                    ToolTip="{Binding CloseToolTip}"
                    IsCancel="True" />
        </StackPanel>
    </Grid>
</Window>
