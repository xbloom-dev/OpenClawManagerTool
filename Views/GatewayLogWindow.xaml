<Window x:Class="OpenClawManager.Views.GatewayLogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding WindowTitle}"
        Height="600" Width="1000"
        MinHeight="300" MinWidth="600"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize">

    <DockPanel Margin="8">

        <!-- Horní lišta: info + dropdown + Aktualizovat + Kopírovat -->
        <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition />
                <RowDefinition />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Grid.ColumnSpan="5"
                       x:Name="TxtLogPath"
                       FontFamily="Consolas" FontSize="11"
                       Foreground="Gray"
                       Text="{Binding LogPathInfo}"
                       TextWrapping="Wrap"
                       Margin="0,0,0,4" />

            <TextBlock Grid.Row="1" Grid.Column="0"
                       Text="Zobrazit:"
                       VerticalAlignment="Center" />

            <ComboBox Grid.Row="1" Grid.Column="1"
                      x:Name="CmbLineCount"
                      Width="160" Height="24"
                      VerticalContentAlignment="Center"
                      Margin="8,0"
                      ToolTip="Počet zobrazených řádků od konce logu">
                <ComboBoxItem Content="Posledních 10 řádků" Tag="10" />
                <ComboBoxItem Content="Posledních 20 řádků" Tag="20" />
                <ComboBoxItem Content="Posledních 30 řádků" Tag="30" />
                <ComboBoxItem Content="Posledních 50 řádků" Tag="50" />
                <ComboBoxItem Content="Posledních 100 řádků" Tag="100" />
                <ComboBoxItem Content="Celý log" Tag="0" />
            </ComboBox>

            <Button Grid.Row="1" Grid.Column="2"
                    x:Name="BtnRefresh"
                    Content="{Binding RefreshText}"
                    Width="100" Height="24"
                    Margin="4,0"
                    ToolTip="{Binding RefreshToolTip}" />

            <Button Grid.Row="1" Grid.Column="3"
                    x:Name="BtnCopy"
                    Content="{Binding CopyText}"
                    Width="100" Height="24"
                    Margin="4,0"
                    Background="{DynamicResource Brush.ActionUtility}"
                    ToolTip="{Binding CopyToolTip}" />

            <!-- Feedback text "Zkopírováno" — zobrazí se vedle Kopírovat na 2s -->
            <TextBlock Grid.Row="1" Grid.Column="4"
                       x:Name="TxtCopiedFeedback"
                       Text="{Binding CopiedFeedbackText}"
                       FontWeight="Bold" Foreground="Green"
                       VerticalAlignment="Center"
                       Margin="6,0,0,0"
                       Opacity="0" />
        </Grid>

        <!-- Spodní lišta: status vlevo + Živá data + Zavřít vpravo -->
        <Grid DockPanel.Dock="Bottom">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StatusBar Grid.Column="0" Height="22" Background="Transparent">
                <StatusBarItem>
                    <TextBlock x:Name="TxtStatus" Text="{Binding StatusText}" />
                </StatusBarItem>
            </StatusBar>

            <Button Grid.Column="1"
                    x:Name="BtnLiveLog"
                    Content="{Binding LiveLogText}"
                    Width="100" Height="24"
                    Margin="4,2"
                    Background="{DynamicResource Brush.ActionPositive}"
                    ToolTip="{Binding LiveLogToolTip}" />

            <Button Grid.Column="2"
                    x:Name="BtnClose"
                    Content="{Binding CloseText}"
                    Width="80" Height="24"
                    Margin="4,2"
                    Background="{DynamicResource Brush.ActionDanger}"
                    ToolTip="{Binding CloseToolTip}"
                    IsCancel="True" />
        </Grid>

        <Border BorderBrush="Gray" BorderThickness="1">
            <TextBox x:Name="TxtLogContent"
                     Text="{Binding LogContent, Mode=OneWay}"
                     IsReadOnly="True"
                     FontFamily="Consolas"
                     FontSize="11"
                     Background="#1E1E1E"
                     Foreground="#DCDCDC"
                     VerticalScrollBarVisibility="Auto"
                     HorizontalScrollBarVisibility="Auto"
                     TextWrapping="NoWrap"
                     Padding="6" />
        </Border>

    </DockPanel>
</Window>
