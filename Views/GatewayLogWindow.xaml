<Window x:Class="OpenClawManager.Views.GatewayLogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="OpenClaw Manager — Gateway Log"
        Height="600" Width="1000"
        MinHeight="300" MinWidth="600"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize">

    <DockPanel Margin="8">

        <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition />
                <RowDefinition />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Grid.ColumnSpan="4"
                       x:Name="TxtLogPath"
                       FontFamily="Consolas" FontSize="11"
                       Foreground="Gray"
                       TextWrapping="Wrap"
                       Margin="0,0,0,4" />

            <TextBlock Grid.Row="1" Grid.Column="0"
                       Text="Zobrazit:"
                       VerticalAlignment="Center" />

            <ComboBox Grid.Row="1" Grid.Column="1"
                      x:Name="CmbLineCount"
                      Width="160" Height="24"
                      VerticalContentAlignment="Center"
                      Margin="8,0">
                <ComboBoxItem Content="Posledních 10 řádků" Tag="10" />
                <ComboBoxItem Content="Posledních 20 řádků" Tag="20" />
                <ComboBoxItem Content="Posledních 30 řádků" Tag="30" />
                <ComboBoxItem Content="Posledních 50 řádků" Tag="50" />
                <ComboBoxItem Content="Posledních 100 řádků" Tag="100" />
                <ComboBoxItem Content="Celý log" Tag="0" />
            </ComboBox>

            <Button Grid.Row="1" Grid.Column="2"
                    x:Name="BtnRefresh"
                    Content="Aktualizovat"
                    Width="100" Height="24"
                    Margin="4,0" />

            <Button Grid.Row="1" Grid.Column="3"
                    x:Name="BtnClose"
                    Content="Zavřít"
                    Width="80" Height="24"
                    Margin="4,0" />
        </Grid>

        <StatusBar DockPanel.Dock="Bottom" Height="22">
            <StatusBarItem>
                <TextBlock x:Name="TxtStatus" Text="Připraveno." />
            </StatusBarItem>
        </StatusBar>

        <Border BorderBrush="Gray" BorderThickness="1">
            <TextBox x:Name="TxtLogContent"
                     IsReadOnly="True"
                     FontFamily="Consolas"
                     FontSize="11"
                     Background="#1E1E1E"
                     Foreground="#DCDCDC"
                     VerticalScrollBarVisibility="Auto"
                     HorizontalScrollBarVisibility="Auto"
                     TextWrapping="NoWrap"
                     Padding="6" />
        </Border>

    </DockPanel>
</Window>
