<UserControl x:Class="OpenClawManager.Views.TerminalControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
             Background="#1E1E1E">

    <Grid>
        <!-- WebView2 — MUSÍ být Hidden (ne Collapsed).
             Hidden = neviditelný ale v layout stromě s HWND → inicializace funguje.
             Collapsed = vyňat z layout stromě → WebView2 nemá HWND → race condition.
             SplashBorder (níže) ho vizuálně překrývá. -->
        <wv2:WebView2 x:Name="WebView"
                      HorizontalAlignment="Stretch"
                      VerticalAlignment="Stretch"
                      Visibility="Hidden" />

        <!-- SplashBorder — překrývá WebView dokud terminál není připraven.
             Explicitně Visible. Skrytý z code-behind při _webViewReady = true.
             Znovu Visible po StopTui / OnConPtyExited. -->
        <Border x:Name="SplashBorder"
                Background="#1E1E1E"
                Visibility="Visible">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock x:Name="SplashLogo"
                           FontFamily="Consolas, Courier New, monospace"
                           FontSize="11"
                           Foreground="#4EC9B0"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,16"
                           Text="                                                            &#x0a;     ██████╗ ██████╗ ███████╗███╗   ██╗ ██████╗██╗      █████╗ ██╗    ██╗&#x0a;    ██╔═══██╗██╔══██╗██╔════╝████╗  ██║██╔════╝██║     ██╔══██╗██║    ██║&#x0a;    ██║   ██║██████╔╝█████╗  ██╔██╗ ██║██║     ██║     ███████║██║ █╗ ██║&#x0a;    ██║   ██║██╔═══╝ ██╔══╝  ██║╚██╗██║██║     ██║     ██╔══██║██║███╗██║&#x0a;    ╚██████╔╝██║     ███████╗██║ ╚████║╚██████╗███████╗██║  ██║╚███╔███╔╝&#x0a;     ╚═════╝ ╚═╝     ╚══════╝╚═╝  ╚═══╝ ╚═════╝╚══════╝╚═╝  ╚═╝ ╚══╝╚══╝ &#x0a;                                                                          " />
                <TextBlock x:Name="SplashSubtitle"
                           Text="Manager Tool by Bloom"
                           Foreground="#888888"
                           FontSize="14"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,24" />
                <TextBlock x:Name="StatusText"
                           Text="Inicializuji WebView2..."
                           Foreground="#666666"
                           FontSize="11"
                           FontStyle="Italic"
                           HorizontalAlignment="Center" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
