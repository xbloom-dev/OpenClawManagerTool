<Window x:Class="OpenClawManager.Views.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="OpenClaw Manager — O aplikaci"
        Height="535" Width="440"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">

    <Grid Margin="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="180" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <wv2:WebView2 x:Name="SvgView" Grid.Row="0" />

        <StackPanel Grid.Row="1" Margin="24,12,24,8">

            <TextBlock x:Name="TxtTitle"
                       Text="OpenClaw Manager Tool by Bloom"
                       FontSize="16" FontWeight="Bold"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,4" />

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,12">
                <TextBlock Text="v1.0  |  " Foreground="Gray" FontSize="12" />
                <TextBlock Text=".NET 8  |  WPF  |  WebView2 + ConPTY"
                           Foreground="Gray" FontSize="12" />
            </StackPanel>

            <Border x:Name="ShortcutFrame"
                    Background="#F5F5F5" BorderBrush="#E0E0E0" BorderThickness="1"
                    CornerRadius="4" Padding="12,8" Margin="0,0,0,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition /> <RowDefinition /> <RowDefinition />
                        <RowDefinition /> <RowDefinition /> <RowDefinition />
                        <RowDefinition /> <RowDefinition />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Ctrl+T" FontFamily="Consolas" Foreground="#0066CC" FontSize="11" />
                    <TextBlock Grid.Row="0" Grid.Column="2" x:Name="TxtShortcut_T" FontSize="11" />

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Ctrl+G" FontFamily="Consolas" Foreground="#0066CC" FontSize="11" />
                    <TextBlock Grid.Row="1" Grid.Column="2" x:Name="TxtShortcut_G" FontSize="11" />

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Ctrl+R" FontFamily="Consolas" Foreground="#0066CC" FontSize="11" />
                    <TextBlock Grid.Row="2" Grid.Column="2" x:Name="TxtShortcut_R" FontSize="11" />

                    <TextBlock Grid.Row="3" Grid.Column="0" Text="Ctrl+Shift+C" FontFamily="Consolas" Foreground="#0066CC" FontSize="11" />
                    <TextBlock Grid.Row="3" Grid.Column="2" x:Name="TxtShortcut_C" FontSize="11" />

                    <TextBlock Grid.Row="4" Grid.Column="0" Text="Ctrl+," FontFamily="Consolas" Foreground="#0066CC" FontSize="11" />
                    <TextBlock Grid.Row="4" Grid.Column="2" x:Name="TxtShortcut_Settings" FontSize="11" />

                    <TextBlock Grid.Row="5" Grid.Column="0" Text="Ctrl+L" FontFamily="Consolas" Foreground="#0066CC" FontSize="11" />
                    <TextBlock Grid.Row="5" Grid.Column="2" x:Name="TxtShortcut_L" FontSize="11" />

                    <TextBlock Grid.Row="6" Grid.Column="0" Text="F1" FontFamily="Consolas" Foreground="#0066CC" FontSize="11" />
                    <TextBlock Grid.Row="6" Grid.Column="2" x:Name="TxtShortcut_F1" FontSize="11" />

                    <TextBlock Grid.Row="7" Grid.Column="0" Text="Alt+F4" FontFamily="Consolas" Foreground="#0066CC" FontSize="11" />
                    <TextBlock Grid.Row="7" Grid.Column="2" x:Name="TxtShortcut_AltF4" FontSize="11" />
                </Grid>
            </Border>
        </StackPanel>

        <Button x:Name="BtnClose" Grid.Row="2"
                Content="Zavřít" Width="100" Height="28"
                HorizontalAlignment="Right"
                Margin="0,0,24,16"
                IsCancel="True"
                ToolTip="Zavře dialog." />
    </Grid>
</Window>
