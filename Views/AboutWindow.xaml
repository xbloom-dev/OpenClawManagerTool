<Window x:Class="OpenClawManager.Views.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="{Binding WindowTitle}"
        Height="535" Width="440"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">

    <Grid Margin="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="180" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0"
              HorizontalAlignment="Center"
              VerticalAlignment="Center">
            <wv2:WebView2 x:Name="SvgView"
                           Width="140" Height="140"
                           Focusable="True" />
        </Grid>

        <StackPanel Grid.Row="1" Margin="24,12,24,8">

            <TextBlock x:Name="TxtTitle"
                       Text="{Binding AppName}"
                       FontSize="16" FontWeight="Bold"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,4" />

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,12">
                <TextBlock Text="{Binding AppVersion}" Foreground="Gray" FontSize="12" />
                <TextBlock Text="  |  " Foreground="Gray" FontSize="12" />
                <TextBlock Text="{Binding RuntimeInfo}"
                           Foreground="Gray" FontSize="12" />
            </StackPanel>

            <Border x:Name="ShortcutFrame"
                    Background="{DynamicResource Theme.Brush.ShortcutBackground}"
                    BorderBrush="{DynamicResource Theme.Brush.ShortcutBorder}"
                    BorderThickness="1"
                    CornerRadius="4" Padding="12,8" Margin="0,0,0,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition /> <RowDefinition /> <RowDefinition />
                        <RowDefinition /> <RowDefinition /> <RowDefinition />
                        <RowDefinition /> <RowDefinition />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Ctrl+T" FontFamily="Consolas" Foreground="{DynamicResource Theme.Brush.ShortcutKeyText}" FontSize="11" />
                    <TextBlock Grid.Row="0" Grid.Column="2" Text="{Binding StartTuiShortcut}" FontSize="11" />

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Ctrl+G" FontFamily="Consolas" Foreground="{DynamicResource Theme.Brush.ShortcutKeyText}" FontSize="11" />
                    <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding GatewayShortcut}" FontSize="11" />

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Ctrl+R" FontFamily="Consolas" Foreground="{DynamicResource Theme.Brush.ShortcutKeyText}" FontSize="11" />
                    <TextBlock Grid.Row="2" Grid.Column="2" Text="{Binding RestartGatewayShortcut}" FontSize="11" />

                    <TextBlock Grid.Row="3" Grid.Column="0" Text="Ctrl+Shift+C" FontFamily="Consolas" Foreground="{DynamicResource Theme.Brush.ShortcutKeyText}" FontSize="11" />
                    <TextBlock Grid.Row="3" Grid.Column="2" Text="{Binding CleaningToolShortcut}" FontSize="11" />

                    <TextBlock Grid.Row="4" Grid.Column="0" Text="Ctrl+," FontFamily="Consolas" Foreground="{DynamicResource Theme.Brush.ShortcutKeyText}" FontSize="11" />
                    <TextBlock Grid.Row="4" Grid.Column="2" Text="{Binding SettingsShortcut}" FontSize="11" />

                    <TextBlock Grid.Row="5" Grid.Column="0" Text="Ctrl+L" FontFamily="Consolas" Foreground="{DynamicResource Theme.Brush.ShortcutKeyText}" FontSize="11" />
                    <TextBlock Grid.Row="5" Grid.Column="2" Text="{Binding GatewayLiveLogShortcut}" FontSize="11" />

                    <TextBlock Grid.Row="6" Grid.Column="0" Text="F1" FontFamily="Consolas" Foreground="{DynamicResource Theme.Brush.ShortcutKeyText}" FontSize="11" />
                    <TextBlock Grid.Row="6" Grid.Column="2" Text="{Binding AboutShortcut}" FontSize="11" />

                    <TextBlock Grid.Row="7" Grid.Column="0" Text="Alt+F4" FontFamily="Consolas" Foreground="{DynamicResource Theme.Brush.ShortcutKeyText}" FontSize="11" />
                    <TextBlock Grid.Row="7" Grid.Column="2" Text="{Binding CloseApplicationShortcut}" FontSize="11" />
                </Grid>
            </Border>
        </StackPanel>

        <Button x:Name="BtnClose" Grid.Row="2"
                Content="{Binding CloseText}" Width="100" Height="28"
                HorizontalAlignment="Right"
                Margin="0,0,24,16"
                IsCancel="True"
                ToolTip="{Binding CloseToolTip}" />
    </Grid>
</Window>
