<Window x:Class="OpenClawManager.Views.StopGatewayDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Zastavit Gateway"
        Height="220" Width="450"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="Opravdu zastavit Gateway?"
                   FontWeight="Bold"
                   FontSize="14"
                   Margin="0,0,0,8" />

        <TextBlock Grid.Row="1"
                   Text="Všechny aktivní TUI sessions budou přerušeny."
                   TextWrapping="Wrap"
                   Margin="0,0,0,16" />

        <CheckBox Grid.Row="2"
                  x:Name="ChkCloseTui"
                  Content="Zavřít také TUI okna (PowerShell wrappery)"
                  Margin="0,0,0,8"
                  VerticalAlignment="Top" />

        <StackPanel Grid.Row="3"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right">
            <Button x:Name="BtnYes" Content="Ano"
                    Width="80" Height="28" Margin="4,0"
                    IsDefault="True" />
            <Button x:Name="BtnNo" Content="Ne"
                    Width="80" Height="28" Margin="4,0"
                    IsCancel="True" />
        </StackPanel>
    </Grid>
</Window>
