<Window x:Class="OpenClawManager.Views.TokenManagerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:OpenClawManager.Views"
        Title="{Binding WindowTitle}"
        Height="800" Width="960"
        MinHeight="600" MinWidth="760"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <views:BindingProxy x:Key="VmProxy" Data="{Binding}" />
    </Window.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="230" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <GroupBox x:Name="GrpVault" Grid.Row="0" Padding="8" Margin="0,0,0,8"
                  Header="{Binding GrpVaultHeader}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock x:Name="TxtVaultLabel" Grid.Column="0"
                           Text="{Binding VaultLabel}"
                           VerticalAlignment="Center" Margin="0,0,8,0" />
                <TextBlock Grid.Column="1" x:Name="TxtVaultPath"
                           Text="{Binding VaultPathDisplay}"
                           FontFamily="Consolas"
                           TextTrimming="CharacterEllipsis"
                           VerticalAlignment="Center" />
                <Button Grid.Column="2" x:Name="BtnInitVault"
                        Content="{Binding BtnInitVaultContent}"
                        ToolTip="{Binding BtnInitVaultToolTip}"
                        Width="105" Height="26"
                        Margin="8,0,0,0" />
                <Button Grid.Column="3" x:Name="BtnRefresh"
                        Content="{Binding BtnRefreshContent}"
                        ToolTip="{Binding BtnRefreshToolTip}"
                        Width="85" Height="26"
                        Margin="6,0,0,0" />
                <Button Grid.Column="4" x:Name="BtnOpenVaultFolder"
                        Content="{Binding BtnOpenFolderContent}"
                        ToolTip="{Binding BtnOpenFolderToolTip}"
                        Width="85" Height="26"
                        Margin="6,0,0,0" />
                <Button Grid.Column="5" x:Name="BtnAddGitIgnore"
                        Content=".gitignore"
                        ToolTip="{Binding BtnAddGitIgnoreToolTip}"
                        Width="85" Height="26"
                        Margin="6,0,0,0" />
                <Button Grid.Column="6" x:Name="BtnBackupVault"
                        Content="{Binding BtnBackupContent}"
                        ToolTip="{Binding BtnBackupToolTip}"
                        Width="90" Height="26"
                        Margin="6,0,0,0" />
                <Button Grid.Column="7" x:Name="BtnRestoreVault"
                        Content="{Binding BtnRestoreVaultContent}"
                        ToolTip="{Binding BtnRestoreVaultToolTip}"
                        Width="90" Height="26"
                        Margin="6,0,0,0" />
            </Grid>
        </GroupBox>

        <Border x:Name="VaultWarningBanner" Grid.Row="1"
                Visibility="{Binding IsVaultSafetyWarningVisible, Converter={StaticResource BoolToVisibility}}"
                Padding="9,6"
                Margin="0,0,0,8"
                BorderBrush="#B00020"
                BorderThickness="1"
                CornerRadius="2"
                Background="#FFF1F1">
            <TextBlock x:Name="TxtVaultWarning"
                       Text="{Binding VaultSafetyWarningText}"
                       Foreground="#8A0018"
                       FontWeight="SemiBold"
                       TextWrapping="Wrap" />
        </Border>

        <GroupBox x:Name="GrpTokens" Grid.Row="2" Padding="6" Margin="0,0,0,8"
                  Header="{Binding GrpTokensHeader}">
            <DataGrid x:Name="TokenGrid"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      IsReadOnly="True"
                      SelectionMode="Single"
                      HeadersVisibility="Column"
                      GridLinesVisibility="Horizontal">
                <DataGrid.Columns>
                    <DataGridTextColumn x:Name="ColId" Header="ID" Binding="{Binding Id}" Width="180" />
                    <DataGridTextColumn x:Name="ColDescription"
                                        Header="{Binding Data.ColDescriptionHeader, Source={StaticResource VmProxy}}"
                                        Binding="{Binding Description}" Width="*" />
                    <DataGridTextColumn x:Name="ColCreated"
                                        Header="{Binding Data.ColCreatedHeader, Source={StaticResource VmProxy}}"
                                        Binding="{Binding CreatedAt, StringFormat={}{0:yyyy-MM-dd HH:mm}}" Width="145" />
                    <DataGridTextColumn x:Name="ColPreview"
                                        Header="{Binding Data.ColPreviewHeader, Source={StaticResource VmProxy}}"
                                        Binding="{Binding ValuePreview}" Width="110" />
                </DataGrid.Columns>
            </DataGrid>
        </GroupBox>

        <StackPanel Grid.Row="3"
                    Orientation="Horizontal"
                    Margin="0,0,0,10">
            <Button x:Name="BtnAdd"
                    Content="{Binding BtnAddContent}"
                    ToolTip="{Binding BtnAddToolTip}"
                    Width="90" Height="28" Margin="0,0,6,0" />
            <Button x:Name="BtnImport"
                    Content="{Binding BtnImportContent}"
                    ToolTip="{Binding BtnImportToolTip}"
                    Width="90" Height="28" Margin="0,0,6,0" />
            <Button x:Name="BtnEdit"
                    Content="{Binding BtnEditContent}"
                    ToolTip="{Binding BtnEditToolTip}"
                    IsEnabled="{Binding IsTokenSelected}"
                    Width="90" Height="28" Margin="0,0,6,0" />
            <Button x:Name="BtnRemove"
                    Content="{Binding BtnRemoveContent}"
                    ToolTip="{Binding BtnRemoveToolTip}"
                    IsEnabled="{Binding IsTokenSelected}"
                    Width="90" Height="28" Margin="0,0,6,0" />
            <Button x:Name="BtnRotate"
                    Content="{Binding BtnRotateContent}"
                    ToolTip="{Binding BtnRotateToolTip}"
                    IsEnabled="{Binding IsTokenSelected}"
                    Width="90" Height="28" Margin="0,0,6,0" />
            <Button x:Name="BtnCopyPlaceholder"
                    Content="{Binding BtnCopyPlaceholderContent}"
                    ToolTip="{Binding BtnCopyPlaceholderToolTip}"
                    IsEnabled="{Binding IsTokenSelected}"
                    Width="105" Height="28" Margin="0,0,6,0" />
        </StackPanel>

        <GroupBox x:Name="GrpFileOps" Grid.Row="4" Padding="8" Margin="0,0,0,8"
                  Header="{Binding GrpFileOpsHeader}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock x:Name="TxtFileLabel" Grid.Row="0" Grid.Column="0"
                           Text="{Binding FileLabel}"
                           VerticalAlignment="Center"
                           Margin="0,0,8,8" />
                <TextBox x:Name="TxtTargetFile" Grid.Row="0" Grid.Column="1"
                         Height="24" VerticalContentAlignment="Center"
                         Margin="0,0,6,8" />
                <Button x:Name="BtnBrowseTarget" Grid.Row="0" Grid.Column="2"
                        Content="{Binding BtnBrowseContent}"
                        ToolTip="{Binding BtnBrowseToolTip}"
                        Background="{DynamicResource Brush.ActionUtility}"
                        Width="105" Height="24"
                        Margin="0,0,0,8" />

                <StackPanel Grid.Row="1" Grid.Column="1"
                            Orientation="Horizontal"
                            Margin="0,0,0,8">
                    <Button x:Name="BtnRedactPreview"
                            Content="{Binding BtnRedactPreviewContent}"
                            ToolTip="{Binding BtnRedactPreviewToolTip}"
                            Width="90" Height="28" Margin="0,0,6,0" />
                    <Button x:Name="BtnRedact"
                            Content="{Binding BtnRedactContent}"
                            ToolTip="{Binding BtnRedactToolTip}"
                            Background="{DynamicResource Brush.ActionPositive}"
                            FontWeight="Bold"
                            Width="90" Height="28" Margin="0,0,6,0" />
                    <Button x:Name="BtnRestore"
                            Content="{Binding BtnRestoreFileContent}"
                            ToolTip="{Binding BtnRestoreFileToolTip}"
                            Background="{DynamicResource Brush.ActionDanger}"
                            Width="90" Height="28" Margin="0,0,6,0" />
                    <Button x:Name="BtnVerify"
                            Content="{Binding BtnVerifyContent}"
                            ToolTip="{Binding BtnVerifyToolTip}"
                            Background="{DynamicResource Brush.ActionUtility}"
                            FontWeight="Bold"
                            Width="90" Height="28" Margin="0,0,12,0" />
                    <CheckBox x:Name="ChkRestoreInPlace"
                              Content="{Binding ChkRestoreInPlaceContent}"
                              ToolTip="{Binding ChkRestoreInPlaceToolTip}"
                              VerticalAlignment="Center" />
                </StackPanel>

                <Border Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3"
                        Padding="8,5"
                        Margin="0,0,0,8"
                        BorderBrush="LightGray"
                        BorderThickness="1"
                        CornerRadius="2"
                        Background="#F7F7F7">
                    <TextBlock x:Name="TxtVerifyStatus"
                               FontWeight="Bold"
                               Foreground="Gray" />
                </Border>

                <TextBox x:Name="TxtOutput" Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="3"
                         Text="{Binding OutputLog, Mode=OneWay}"
                         IsReadOnly="True"
                         FontFamily="Consolas"
                         FontSize="11"
                         Background="#1E1E1E"
                         Foreground="#DCDCDC"
                         VerticalScrollBarVisibility="Auto"
                         HorizontalScrollBarVisibility="Auto"
                         TextWrapping="NoWrap"
                         Padding="6" />
            </Grid>
        </GroupBox>

        <StackPanel Grid.Row="5"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right">
            <Button x:Name="BtnClose"
                    Content="{Binding BtnCloseContent}"
                    ToolTip="{Binding BtnCloseToolTip}"
                    Background="{DynamicResource Brush.ActionDanger}"
                    Width="90" Height="28"
                    IsCancel="True" />
        </StackPanel>
    </Grid>
</Window>
