<Window x:Class="OpenClawManager.Views.TokenManagerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Správce API klíčů"
        Height="800" Width="960"
        MinHeight="600" MinWidth="760"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize">

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="230" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <GroupBox x:Name="GrpVault" Grid.Row="0" Padding="8" Margin="0,0,0,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock x:Name="TxtVaultLabel" Grid.Column="0"
                           VerticalAlignment="Center" Margin="0,0,8,0" />
                <TextBlock Grid.Column="1" x:Name="TxtVaultPath"
                           FontFamily="Consolas"
                           TextTrimming="CharacterEllipsis"
                           VerticalAlignment="Center" />
                <Button Grid.Column="2" x:Name="BtnInitVault"
                        Width="105" Height="26"
                        Margin="8,0,0,0" />
                <Button Grid.Column="3" x:Name="BtnRefresh"
                        Width="85" Height="26"
                        Margin="6,0,0,0" />
                <Button Grid.Column="4" x:Name="BtnOpenVaultFolder"
                        Width="85" Height="26"
                        Margin="6,0,0,0" />
                <Button Grid.Column="5" x:Name="BtnAddGitIgnore"
                        Content=".gitignore" Width="85" Height="26"
                        Margin="6,0,0,0" />
            </Grid>
        </GroupBox>

        <Border x:Name="VaultWarningBanner" Grid.Row="1"
                Visibility="Collapsed"
                Padding="9,6"
                Margin="0,0,0,8"
                BorderBrush="#B00020"
                BorderThickness="1"
                CornerRadius="2"
                Background="#FFF1F1">
            <TextBlock x:Name="TxtVaultWarning"
                       Foreground="#8A0018"
                       FontWeight="SemiBold"
                       TextWrapping="Wrap" />
        </Border>

        <GroupBox x:Name="GrpTokens" Grid.Row="2" Padding="6" Margin="0,0,0,8">
            <DataGrid x:Name="TokenGrid"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      IsReadOnly="True"
                      SelectionMode="Single"
                      HeadersVisibility="Column"
                      GridLinesVisibility="Horizontal">
                <DataGrid.Columns>
                    <DataGridTextColumn x:Name="ColId" Header="ID" Binding="{Binding Id}" Width="180" />
                    <DataGridTextColumn x:Name="ColDescription" Binding="{Binding Description}" Width="*" />
                    <DataGridTextColumn x:Name="ColCreated" Binding="{Binding CreatedAt, StringFormat={}{0:yyyy-MM-dd HH:mm}}" Width="145" />
                    <DataGridTextColumn x:Name="ColPreview" Binding="{Binding ValuePreview}" Width="110" />
                </DataGrid.Columns>
            </DataGrid>
        </GroupBox>

        <StackPanel Grid.Row="3"
                    Orientation="Horizontal"
                    Margin="0,0,0,10">
            <Button x:Name="BtnAdd"
                    Width="90" Height="28" Margin="0,0,6,0" />
            <Button x:Name="BtnImport"
                    Width="90" Height="28" Margin="0,0,6,0" />
            <Button x:Name="BtnEdit"
                    Width="90" Height="28" Margin="0,0,6,0" />
            <Button x:Name="BtnRemove"
                    Width="90" Height="28" Margin="0,0,6,0" />
            <Button x:Name="BtnRotate"
                    Width="90" Height="28" Margin="0,0,6,0" />
            <Button x:Name="BtnCopyPlaceholder"
                    Width="105" Height="28" Margin="0,0,6,0" />
        </StackPanel>

        <GroupBox x:Name="GrpFileOps" Grid.Row="4" Padding="8" Margin="0,0,0,8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock x:Name="TxtFileLabel" Grid.Row="0" Grid.Column="0"
                           VerticalAlignment="Center"
                           Margin="0,0,8,8" />
                <TextBox x:Name="TxtTargetFile" Grid.Row="0" Grid.Column="1"
                         Height="24" VerticalContentAlignment="Center"
                         Margin="0,0,6,8" />
                <Button x:Name="BtnBrowseTarget" Grid.Row="0" Grid.Column="2"
                        Width="105" Height="24"
                        Margin="0,0,0,8" />

                <StackPanel Grid.Row="1" Grid.Column="1"
                            Orientation="Horizontal"
                            Margin="0,0,0,8">
                    <Button x:Name="BtnRedactPreview"
                            Width="90" Height="28" Margin="0,0,6,0" />
                    <Button x:Name="BtnRedact"
                            Width="90" Height="28" Margin="0,0,6,0" />
                    <Button x:Name="BtnRestore"
                            Width="90" Height="28" Margin="0,0,6,0" />
                    <Button x:Name="BtnVerify"
                            Width="90" Height="28" Margin="0,0,12,0" />
                    <CheckBox x:Name="ChkRestoreInPlace"
                              VerticalAlignment="Center" />
                </StackPanel>

                <Border Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3"
                        Padding="8,5"
                        Margin="0,0,0,8"
                        BorderBrush="LightGray"
                        BorderThickness="1"
                        CornerRadius="2"
                        Background="#F7F7F7">
                    <TextBlock x:Name="TxtVerifyStatus"
                               FontWeight="Bold"
                               Foreground="Gray" />
                </Border>

                <TextBox x:Name="TxtOutput" Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="3"
                         IsReadOnly="True"
                         FontFamily="Consolas"
                         FontSize="11"
                         Background="#1E1E1E"
                         Foreground="#DCDCDC"
                         VerticalScrollBarVisibility="Auto"
                         HorizontalScrollBarVisibility="Auto"
                         TextWrapping="NoWrap"
                         Padding="6" />
            </Grid>
        </GroupBox>

        <StackPanel Grid.Row="5"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right">
            <Button x:Name="BtnClose"
                    Width="90" Height="28"
                    IsCancel="True" />
        </StackPanel>
    </Grid>
</Window>

