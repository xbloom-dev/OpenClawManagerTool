<Window x:Class="OpenClawManager.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding WindowTitle}"
        Height="700" Width="640"
        MinHeight="560" MinWidth="560"
        WindowStartupLocation="CenterOwner">
    <DockPanel Margin="16">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="{Binding SaveText}"
                    Command="{Binding SaveCommand}"
                    ToolTip="{Binding SaveToolTip}"
                    Width="100" Height="28" Margin="4,0"
                    Background="{DynamicResource Brush.ActionPositive}"
                    IsDefault="True" />
            <Button Content="{Binding ResetText}"
                    Command="{Binding ResetCommand}"
                    ToolTip="{Binding ResetToolTip}"
                    Width="130" Height="28" Margin="4,0"
                    Background="{DynamicResource Brush.ActionUtility}" />
            <Button Content="{Binding CancelText}"
                    Command="{Binding CancelCommand}"
                    ToolTip="{Binding CancelToolTip}"
                    Width="100" Height="28" Margin="4,0"
                    Background="{DynamicResource Brush.ActionDanger}"
                    IsCancel="True" />
        </StackPanel>

        <ScrollViewer VerticalScrollBarVisibility="Hidden">
            <StackPanel>
                <TextBlock Text="{Binding LanguageTitle}" FontWeight="Bold" Margin="0,0,0,6" />
                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                    <RadioButton Content="{Binding CzechLanguageText}" IsChecked="{Binding IsLanguageCzech, Mode=TwoWay}" GroupName="Language" Margin="0,0,16,0" />
                    <RadioButton Content="English" IsChecked="{Binding IsLanguageEnglish, Mode=TwoWay}" GroupName="Language" />
                </StackPanel>
                <TextBlock Text="{Binding LanguageHint}" Foreground="Gray" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,14" />

                <TextBlock Text="{Binding AppearanceTitle}" FontWeight="Bold" Margin="0,0,0,6" />
                <TextBlock Text="{Binding ThemeLabel}" Margin="0,0,0,4" />
                <WrapPanel Margin="0,0,0,6">
                    <RadioButton Content="{Binding ThemeLegacyText}" IsChecked="{Binding IsThemeLegacy, Mode=TwoWay}" GroupName="Theme" Margin="0,0,16,0" />
                    <RadioButton Content="{Binding ThemeModernText}" IsChecked="{Binding IsThemeModern, Mode=TwoWay}" GroupName="Theme" Margin="0,0,16,0" />
                    <RadioButton Content="{Binding ThemeStandardDarkText}" IsChecked="{Binding IsThemeStandardDark, Mode=TwoWay}" GroupName="Theme" Margin="0,0,16,0" />
                    <RadioButton Content="{Binding ThemeDarkText}" IsChecked="{Binding IsThemeDark, Mode=TwoWay}" GroupName="Theme" Margin="0,0,16,0" />
                    <RadioButton Content="{Binding ThemeModernLightText}" IsChecked="{Binding IsThemeModernLight, Mode=TwoWay}" GroupName="Theme" Margin="0,0,16,0" />
                    <RadioButton Content="{Binding ThemeHighContrastText}" IsChecked="{Binding IsThemeHighContrast, Mode=TwoWay}" GroupName="Theme" Margin="0,0,16,0" />
                    <RadioButton Content="{Binding ThemeCrabCuteText}" IsChecked="{Binding IsThemeCrabCute, Mode=TwoWay}" GroupName="Theme" />
                </WrapPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                    <CheckBox Content="{Binding UseSplashVideoText}"
                              IsChecked="{Binding UseSplashVideo, Mode=TwoWay}"
                              IsEnabled="{Binding AreModernThemeOptionsEnabled}"
                              Margin="0,0,16,0" />
                    <CheckBox Content="{Binding UseButtonScanlineEffectText}"
                              IsChecked="{Binding UseButtonScanlineEffect, Mode=TwoWay}"
                              IsEnabled="{Binding AreModernThemeOptionsEnabled}" />
                </StackPanel>
                <TextBlock Text="{Binding ThemeHint}" Foreground="Gray" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,14" />

                <TextBlock Text="{Binding PathsTitle}" FontWeight="Bold" Margin="0,0,0,6" />

                <TextBlock Text="{Binding OpenClawPathLabel}" Margin="0,4,0,2" />
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <TextBox Text="{Binding OpenClawPath, UpdateSourceTrigger=PropertyChanged}" Grid.Column="0" Height="24" VerticalContentAlignment="Center" />
                    <Button Command="{Binding BrowseOpenClawPathCommand}" ToolTip="{Binding BrowseToolTip}" Grid.Column="1" Content="{Binding BrowseText}" Width="100" Height="24" Margin="6,0,0,0" />
                </Grid>

                <TextBlock Text="{Binding TempPathLabel}" Margin="0,4,0,2" />
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <TextBox Text="{Binding TempPath, UpdateSourceTrigger=PropertyChanged}" Grid.Column="0" Height="24" VerticalContentAlignment="Center" />
                    <Button Command="{Binding BrowseTempPathCommand}" ToolTip="{Binding BrowseToolTip}" Grid.Column="1" Content="{Binding BrowseText}" Width="100" Height="24" Margin="6,0,0,0" />
                </Grid>

                <TextBlock Text="{Binding OpenClawCommandLabel}" Margin="0,4,0,2" />
                <TextBox Text="{Binding OpenClawCommand, UpdateSourceTrigger=PropertyChanged}" Height="24" VerticalContentAlignment="Center" Margin="0,0,0,2" />
                <TextBlock Text="{Binding OpenClawCommandHint}" Foreground="Gray" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,8" />

                <TextBlock Text="{Binding PowerShellWorkingDirLabel}" Margin="0,4,0,2" />
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <TextBox Text="{Binding PowerShellWorkingDir, UpdateSourceTrigger=PropertyChanged}" Grid.Column="0" Height="24" VerticalContentAlignment="Center" />
                    <Button Command="{Binding BrowsePowerShellWorkingDirCommand}" ToolTip="{Binding BrowseToolTip}" Grid.Column="1" Content="{Binding BrowseText}" Width="100" Height="24" Margin="6,0,0,0" />
                </Grid>
                <TextBlock Text="{Binding PowerShellHint}" Foreground="Gray" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,8" />

                <TextBlock Text="{Binding TokenManagerSecretsLabel}" Margin="0,4,0,2" />
                <Grid Margin="0,0,0,2">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <TextBox Text="{Binding TokenManagerSecretsPath, UpdateSourceTrigger=PropertyChanged}" Grid.Column="0" Height="24" VerticalContentAlignment="Center" />
                    <Button Command="{Binding BrowseTokenManagerSecretsCommand}" ToolTip="{Binding BrowseToolTip}" Grid.Column="1" Content="{Binding BrowseText}" Width="100" Height="24" Margin="6,0,0,0" />
                </Grid>
                <TextBlock Text="{Binding TokenManagerSecretsHint}" Foreground="Gray" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,14" />

                <TextBlock Text="{Binding SettingsPathLabel}" Margin="0,4,0,2" />
                <TextBlock Text="{Binding SettingsFilePath}" FontFamily="Consolas" TextWrapping="Wrap" Foreground="Gray" />
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
