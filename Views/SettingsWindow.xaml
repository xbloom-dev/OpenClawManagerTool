<Window x:Class="OpenClawManager.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="OpenClaw Manager - Settings"
        Height="700" Width="640"
        MinHeight="560" MinWidth="560"
        WindowStartupLocation="CenterOwner">
    <DockPanel Margin="16">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button x:Name="BtnSave" Content="Save" Width="100" Height="28" Margin="4,0" Background="#D0FFD0" IsDefault="True" />
            <Button x:Name="BtnReset" Content="Reset" Width="130" Height="28" Margin="4,0" Background="#D0E8FF" />
            <Button x:Name="BtnCancel" Content="Cancel" Width="100" Height="28" Margin="4,0" Background="#FFD0D0" IsCancel="True" />
        </StackPanel>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock x:Name="LblLanguage" Text="Language" FontWeight="Bold" Margin="0,0,0,6" />
                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                    <RadioButton x:Name="RbLangCS" Content="Čeština" GroupName="Language" Margin="0,0,16,0" />
                    <RadioButton x:Name="RbLangEN" Content="English" GroupName="Language" />
                </StackPanel>
                <TextBlock x:Name="TxtLanguageHint" Foreground="Gray" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,14" />

                <TextBlock x:Name="LblAppearance" Text="Appearance" FontWeight="Bold" Margin="0,0,0,6" />
                <TextBlock x:Name="LblTheme" Text="Theme:" Margin="0,0,0,4" />
                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                    <RadioButton x:Name="RbThemeLegacy" Content="Legacy" GroupName="Theme" Margin="0,0,16,0" />
                    <RadioButton x:Name="RbThemeModern" Content="Modern" GroupName="Theme" />
                </StackPanel>
                <CheckBox x:Name="ChkUseSplashVideo" Content="Play splash video on startup" Margin="0,0,0,4" />
                <TextBlock x:Name="TxtThemeHint" Foreground="Gray" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,14" />

                <TextBlock x:Name="LblPaths" Text="Paths" FontWeight="Bold" Margin="0,0,0,6" />

                <TextBlock x:Name="LblOpenClawPath" Text="OpenClaw folder:" Margin="0,4,0,2" />
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <TextBox x:Name="TxtOpenClawPath" Grid.Column="0" Height="24" VerticalContentAlignment="Center" />
                    <Button x:Name="BtnBrowseOpenClaw" Grid.Column="1" Content="Browse..." Width="100" Height="24" Margin="6,0,0,0" />
                </Grid>

                <TextBlock x:Name="LblTempPath" Text="Temp folder:" Margin="0,4,0,2" />
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <TextBox x:Name="TxtTempPath" Grid.Column="0" Height="24" VerticalContentAlignment="Center" />
                    <Button x:Name="BtnBrowseTemp" Grid.Column="1" Content="Browse..." Width="100" Height="24" Margin="6,0,0,0" />
                </Grid>

                <TextBlock x:Name="LblOpenClawCommand" Text="OpenClaw command:" Margin="0,4,0,2" />
                <TextBox x:Name="TxtOpenClawCommand" Height="24" VerticalContentAlignment="Center" Margin="0,0,0,2" />
                <TextBlock x:Name="TxtOpenClawCommandHint" Foreground="Gray" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,8" />

                <TextBlock x:Name="LblPowerShellWorkingDir" Text="PowerShell working directory:" Margin="0,4,0,2" />
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <TextBox x:Name="TxtPowerShellWorkingDir" Grid.Column="0" Height="24" VerticalContentAlignment="Center" />
                    <Button x:Name="BtnBrowsePowerShell" Grid.Column="1" Content="Browse..." Width="100" Height="24" Margin="6,0,0,0" />
                </Grid>
                <TextBlock x:Name="TxtPowerShellHint" Foreground="Gray" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,8" />

                <TextBlock x:Name="LblTokenManagerSecrets" Text="Token Manager secrets.json:" Margin="0,4,0,2" />
                <Grid Margin="0,0,0,2">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <TextBox x:Name="TxtTokenManagerSecretsPath" Grid.Column="0" Height="24" VerticalContentAlignment="Center" />
                    <Button x:Name="BtnBrowseTokenManagerSecrets" Grid.Column="1" Content="Browse..." Width="100" Height="24" Margin="6,0,0,0" />
                </Grid>
                <TextBlock x:Name="TxtTokenManagerSecretsHint" Foreground="Gray" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,14" />

                <TextBlock x:Name="LblSettingsPath" Text="Settings file:" Margin="0,4,0,2" />
                <TextBlock x:Name="TxtSettingsPath" FontFamily="Consolas" TextWrapping="Wrap" Foreground="Gray" />
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
