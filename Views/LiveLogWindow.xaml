<Window x:Class="OpenClawManager.Views.LiveLogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding WindowTitle}"
        Height="600" Width="1000"
        MinHeight="300" MinWidth="600"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize">

    <DockPanel Margin="8">

        <!-- Top info bar -->
        <TextBlock x:Name="TxtLogPath" DockPanel.Dock="Top"
                   FontFamily="Consolas" FontSize="11"
                   Foreground="Gray" TextWrapping="Wrap"
                   Text="{Binding LogPathInfo}"
                   Margin="0,0,0,6" />

        <!-- Bottom bar: status left, copy and close right -->
        <Grid DockPanel.Dock="Bottom" Margin="0,6,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StatusBar Grid.Column="0" Height="22" Background="Transparent">
                <StatusBarItem>
                    <TextBlock x:Name="TxtStatus" Text="{Binding StatusText}" />
                </StatusBarItem>
            </StatusBar>

            <TextBlock Grid.Column="1"
                       x:Name="TxtCopiedFeedback"
                       Text="{Binding CopiedFeedbackText}"
                       FontWeight="Bold" Foreground="Green"
                       VerticalAlignment="Center"
                       Margin="0,0,6,0"
                       Opacity="0" />

            <Button Grid.Column="2"
                    x:Name="BtnCopy"
                    Content="{Binding CopyText}"
                    Width="100" Height="24"
                    Margin="4,2"
                    Background="{DynamicResource Brush.ActionUtility}"
                    ToolTip="{Binding CopyToolTip}" />

            <Button Grid.Column="3"
                    x:Name="BtnClose"
                    Content="{Binding CloseText}"
                    Width="80" Height="24"
                    Margin="4,2"
                    Background="{DynamicResource Brush.ActionDanger}"
                    IsCancel="True"
                    ToolTip="{Binding CloseToolTip}" />
        </Grid>

        <!-- Log content -->
        <Border BorderBrush="{DynamicResource Theme.Brush.OutputBorder}" BorderThickness="1">
            <TextBox x:Name="TxtLogContent"
                     Text="{Binding LogContent, Mode=OneWay}"
                     IsReadOnly="True"
                     FontFamily="Consolas"
                     FontSize="11"
                     Background="{DynamicResource Theme.Brush.OutputBackground}"
                     Foreground="{DynamicResource Theme.Brush.OutputText}"
                     VerticalScrollBarVisibility="Auto"
                     HorizontalScrollBarVisibility="Auto"
                     TextWrapping="NoWrap"
                     Padding="6" />
        </Border>

    </DockPanel>
</Window>
