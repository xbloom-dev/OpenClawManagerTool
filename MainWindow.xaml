<Window x:Class="OpenClawManager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="OpenClaw Manager Tool by Bloom"
        Height="800" Width="1280"
        MinHeight="500" MinWidth="800"
        WindowStartupLocation="CenterScreen">

    <DockPanel>

        <!-- ===== HORNÍ MENU ===== -->
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="_Otevřít">
                <MenuItem x:Name="MnuOpenOpenClawFolder" Header="_OpenClaw složku" />
                <MenuItem x:Name="MnuOpenTempFolder" Header="_Temp složku (Gateway logy)" />
                <MenuItem Header="_Gateway log">
                    <MenuItem x:Name="MnuOpenLog10" Header="Posledních 10 řádků" Tag="10" />
                    <MenuItem x:Name="MnuOpenLog20" Header="Posledních 20 řádků" Tag="20" />
                    <MenuItem x:Name="MnuOpenLog30" Header="Posledních 30 řádků" Tag="30" />
                    <MenuItem x:Name="MnuOpenLog50" Header="Posledních 50 řádků" Tag="50" />
                    <MenuItem x:Name="MnuOpenLog100" Header="Posledních 100 řádků" Tag="100" />
                    <Separator />
                    <MenuItem x:Name="MnuOpenLogAll" Header="Celý log" Tag="0" />
                </MenuItem>
                <MenuItem x:Name="MnuOpenPowerShell" Header="_PowerShell" />
                <Separator />
                <MenuItem x:Name="MnuExit" Header="_Konec" InputGestureText="Alt+F4" />
            </MenuItem>
            <MenuItem Header="_Nastavení">
                <MenuItem x:Name="MnuSettings" Header="Otevřít _Nastavení..." InputGestureText="Ctrl+," />
            </MenuItem>
            <MenuItem Header="_Nápověda">
                <MenuItem x:Name="MnuAbout" Header="_O aplikaci..." InputGestureText="F1" />
                <MenuItem x:Name="MnuOpenClawWeb" Header="Otevřít web OpenClaw" />
            </MenuItem>
        </Menu>

        <!-- ===== SPODNÍ STATUS BAR — Gateway nalevo, zdroje napravo ===== -->
        <StatusBar DockPanel.Dock="Bottom" Height="24">
            <StatusBarItem>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Gateway: " />
                    <Ellipse x:Name="StatusGatewayDot" Width="10" Height="10"
                             Fill="Gray" Margin="2,0,4,0" VerticalAlignment="Center" />
                    <TextBlock x:Name="StatusGatewayText" Text="neběží" />
                </StackPanel>
            </StatusBarItem>
            <Separator x:Name="StatusGatewayDetailsSep" Visibility="Collapsed" />
            <StatusBarItem x:Name="StatusGatewayPidItem" Visibility="Collapsed">
                <TextBlock x:Name="StatusGatewayPid" Text="PID: —" />
            </StatusBarItem>
            <Separator x:Name="StatusGatewayUptimeSep" Visibility="Collapsed" />
            <StatusBarItem x:Name="StatusGatewayUptimeItem" Visibility="Collapsed">
                <TextBlock x:Name="StatusGatewayUptime" Text="uptime: —" />
            </StatusBarItem>
            <Separator />
            <StatusBarItem>
                <TextBlock x:Name="StatusRam" Text="RAM: —" />
            </StatusBarItem>
            <Separator />
            <StatusBarItem>
                <TextBlock x:Name="StatusVram" Text="VRAM: —" />
            </StatusBarItem>
            <Separator />
            <StatusBarItem>
                <TextBlock x:Name="StatusCpu" Text="CPU: —" />
            </StatusBarItem>
            <StatusBarItem HorizontalAlignment="Right">
                <TextBlock Text="v0.2" Foreground="Gray" />
            </StatusBarItem>
        </StatusBar>

        <!-- ===== HLAVNÍ OBSAH (Grid se 3 sloupci) ===== -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320" />
                <ColumnDefinition Width="5" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Levý panel — bez ScrollVieweru, sekce mají vlastní layout -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Sekce: Akce -->
                <GroupBox Grid.Row="0" Header="Akce" Margin="8,8,8,4" Padding="8">
                    <StackPanel>

                        <!-- Primární tlačítko: OpenClaw TUI -->
                        <Button x:Name="BtnStartTui"
                                Height="48"
                                FontWeight="Bold"
                                FontSize="13"
                                Margin="0,0,0,8"
                                ToolTip="Zastaví Gateway, znovu ho spustí, pak otevře TUI. Použij když je něco rozbité.">
                            <StackPanel Orientation="Vertical">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <TextBlock Text="▶"
                                               Foreground="Green"
                                               FontWeight="Bold"
                                               FontSize="16"
                                               VerticalAlignment="Center"
                                               Margin="0,0,8,0" />
                                    <TextBlock Text="OpenClaw TUI" VerticalAlignment="Center" />
                                </StackPanel>
                                <TextBlock Text="(restart Gateway)"
                                           HorizontalAlignment="Center"
                                           FontSize="10"
                                           FontWeight="Normal"
                                           Foreground="Gray" />
                            </StackPanel>
                        </Button>

                        <!-- Gateway tlačítka — barevné symboly -->
                        <TextBlock Text="Gateway:" FontWeight="Bold" Margin="0,4,0,4" />
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="4" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Button x:Name="BtnGatewayStart" Grid.Column="0"
                                    Height="28"
                                    ToolTip="Spustí openclaw gateway v novém okně">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="▶" Foreground="Green" FontWeight="Bold" Margin="0,0,6,0" />
                                    <TextBlock Text="Start" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="BtnGatewayStop" Grid.Column="2"
                                    Height="28"
                                    IsEnabled="False"
                                    ToolTip="Korektně zastaví běžící Gateway">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="■" Foreground="Red" FontWeight="Bold" Margin="0,0,6,0" />
                                    <TextBlock Text="Stop" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </Grid>
                        <Button x:Name="BtnGatewayRestart"
                                Height="28"
                                Margin="0,0,0,8"
                                IsEnabled="False"
                                ToolTip="Stop + Start Gateway">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <TextBlock Text="↻" Foreground="Orange" FontWeight="Bold" FontSize="14" Margin="0,0,6,0" />
                                <TextBlock Text="Restart" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <!-- Otevřít — emoji jako vlastní TextBlock -->
                        <TextBlock Text="Otevřít:" FontWeight="Bold" Margin="0,4,0,4" />
                        <Button x:Name="BtnOpenPowerShell"
                                Height="28"
                                Margin="0,0,0,4"
                                ToolTip="Otevře nový PowerShell ve složce z Nastavení">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="⚡" FontFamily="Segoe UI Emoji" FontSize="14" Margin="0,0,8,0" />
                                <TextBlock Text="PowerShell" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="BtnOpenGatewayLog"
                                Height="28"
                                Margin="0,0,0,8"
                                ToolTip="Otevře viewer Gateway logu (default: posledních 20 řádků)">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="📄" FontFamily="Segoe UI Emoji" FontSize="14" Margin="0,0,8,0" />
                                <TextBlock Text="Gateway log" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <!-- Nástroje -->
                        <TextBlock Text="Nástroje:" FontWeight="Bold" Margin="0,4,0,4" />
                        <Button x:Name="BtnCleaningTool"
                                Height="28"
                                Margin="0,0,0,4"
                                ToolTip="Otevře nástroj pro čištění starých logů, sessions, cache">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🧹" FontFamily="Segoe UI Emoji" FontSize="14" Margin="0,0,8,0" />
                                <TextBlock Text="Cleaning Tool" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="BtnTokenManager"
                                Height="28"
                                Margin="0,0,0,8"
                                IsEnabled="False"
                                ToolTip="Coming in v0.4 — Správa API klíčů a redakce konfiguračních souborů">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🔑" FontFamily="Segoe UI Emoji" FontSize="14" Margin="0,0,8,0" />
                                <TextBlock Text="Token Manager" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <!-- Údržba -->
                        <TextBlock Text="Údržba:" FontWeight="Bold" Margin="0,4,0,4" />
                        <Button x:Name="BtnDoctorFix"
                                Height="28"
                                ToolTip="Spustí openclaw doctor --fix pro opravu konfigurace">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🩺" FontFamily="Segoe UI Emoji" FontSize="14" Margin="0,0,8,0" />
                                <TextBlock Text="doctor --fix" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                    </StackPanel>
                </GroupBox>

                <!-- Sekce: Měření latence -->
                <GroupBox Grid.Row="1" Header="Měření latence" Margin="8,4,8,4" Padding="8"
                          ToolTip="Měřeno z Gateway logu (res záznamy). Resetuje se při restartu Gateway.">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition />
                            <RowDefinition />
                            <RowDefinition />
                            <RowDefinition />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Poslední:" />
                        <TextBlock Grid.Row="0" Grid.Column="1" x:Name="LatencyLast" Text="—" />

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Průměr 10×:" />
                        <TextBlock Grid.Row="1" Grid.Column="1" x:Name="LatencyAvg" Text="—" />

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Maximum:" />
                        <TextBlock Grid.Row="2" Grid.Column="1" x:Name="LatencyMax" Text="—" />

                        <TextBlock Grid.Row="3" Grid.Column="0" Text="Requestů:" />
                        <TextBlock Grid.Row="3" Grid.Column="1" x:Name="LatencyCount" Text="—" />
                    </Grid>
                </GroupBox>

                <!-- Sekce: Log aplikace s vlastním scrollem -->
                <GroupBox Grid.Row="2" Header="Log aplikace" Margin="8,4,8,8" Padding="8">
                    <ListBox x:Name="AppLog"
                             FontFamily="Consolas"
                             FontSize="11"
                             BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.VerticalScrollBarVisibility="Auto" />
                </GroupBox>

            </Grid>

            <GridSplitter Grid.Column="1"
                          Width="5"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch"
                          Background="LightGray" />

            <Border Grid.Column="2"
                    Background="#1E1E1E"
                    Margin="0">
                <StackPanel VerticalAlignment="Center"
                            HorizontalAlignment="Center">
                    <TextBlock Text="Embedded terminal coming in v0.3"
                               Foreground="#888888"
                               FontSize="14"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,8" />
                    <TextBlock Text="TUI nyní běží v samostatném okně."
                               Foreground="#666666"
                               FontSize="11"
                               HorizontalAlignment="Center" />
                    <TextBlock Text="Klikni „OpenClaw TUI&quot; pro otevření."
                               Foreground="#666666"
                               FontSize="11"
                               HorizontalAlignment="Center" />
                </StackPanel>
            </Border>

        </Grid>

    </DockPanel>
</Window>
