<Window x:Class="OpenClawManager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:OpenClawManager.Views"
        Title="OpenClaw Manager Tool by Bloom"
        Icon="pack://application:,,,/Resources/app-favicon.ico"
        Height="720" Width="1400"
        MinHeight="500" MinWidth="900"
        WindowStartupLocation="CenterScreen">

    <DockPanel>
        <Menu x:Name="MainMenu" DockPanel.Dock="Top">
            <MenuItem x:Name="MnuMenuOpen" Header="_Otevřít">
                <MenuItem x:Name="MnuOpenOpenClawFolder" Header="_OpenClaw složku" />
                <MenuItem x:Name="MnuOpenTempFolder" Header="_Temp složku (Gateway logy)" />
                <MenuItem x:Name="MnuOpenGatewayLog" Header="_Gateway log">
                    <MenuItem x:Name="MnuOpenLog10" Header="Posledních 10 řádků" Tag="10" />
                    <MenuItem x:Name="MnuOpenLog20" Header="Posledních 20 řádků" Tag="20" />
                    <MenuItem x:Name="MnuOpenLog30" Header="Posledních 30 řádků" Tag="30" />
                    <MenuItem x:Name="MnuOpenLog50" Header="Posledních 50 řádků" Tag="50" />
                    <MenuItem x:Name="MnuOpenLog100" Header="Posledních 100 řádků" Tag="100" />
                    <Separator />
                    <MenuItem x:Name="MnuOpenLogAll" Header="Celý log" Tag="0" />
                </MenuItem>
                <MenuItem x:Name="MnuOpenPowerShell" Header="_PowerShell" />
                <Separator />
                <MenuItem x:Name="MnuExit" Header="_Konec" InputGestureText="Alt+F4" />
            </MenuItem>
            <MenuItem x:Name="MnuMenuSettings" Header="_Nastavení">
                <MenuItem x:Name="MnuSettings" Header="Otevřít _Nastavení..." InputGestureText="Ctrl+," />
            </MenuItem>
            <MenuItem x:Name="MnuMenuHelp" Header="_Nápověda">
                <MenuItem x:Name="MnuAbout" Header="_O aplikaci..." InputGestureText="F1" />
                <MenuItem x:Name="MnuOpenClawWeb" Header="Otevřít web OpenClaw" />
            </MenuItem>
        </Menu>

        <StatusBar x:Name="MainStatusBar" DockPanel.Dock="Bottom" Height="24">
            <StatusBarItem>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Gateway: " />
                    <Ellipse x:Name="StatusGatewayDot" Width="10" Height="10"
                             Fill="Gray" Margin="2,0,4,0" VerticalAlignment="Center" />
                    <TextBlock x:Name="StatusGatewayText" Text="neběží" />
                </StackPanel>
            </StatusBarItem>
            <Separator x:Name="StatusGatewayDetailsSep" Visibility="Collapsed" />
            <StatusBarItem x:Name="StatusGatewayPidItem" Visibility="Collapsed">
                <TextBlock x:Name="StatusGatewayPid" Text="PID: —" />
            </StatusBarItem>
            <Separator x:Name="StatusGatewayUptimeSep" Visibility="Collapsed" />
            <StatusBarItem x:Name="StatusGatewayUptimeItem" Visibility="Collapsed">
                <TextBlock x:Name="StatusGatewayUptime" Text="uptime: —" />
            </StatusBarItem>
            <StatusBarItem>
                <TextBlock Text=" " Width="20" />
            </StatusBarItem>
            <Separator />
            <StatusBarItem>
                <TextBlock x:Name="StatusRam" Text="RAM: —" />
            </StatusBarItem>
            <Separator />
            <StatusBarItem>
                <TextBlock x:Name="StatusVram" Text="VRAM: —" />
            </StatusBarItem>
            <Separator />
            <StatusBarItem>
                <TextBlock x:Name="StatusCpu" Text="CPU: —" />
            </StatusBarItem>
            <StatusBarItem HorizontalAlignment="Right">
                <TextBlock Text="v1.0" Foreground="Gray" />
            </StatusBarItem>
        </StatusBar>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="330" />
                <ColumnDefinition Width="5" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Sekce Akce -->
                <GroupBox x:Name="GrpActions" Grid.Row="0" Header="Akce" Margin="6,6,6,3" Padding="6">
                    <StackPanel>

                        <!-- Dynamické TUI tlačítko -->
                        <Button x:Name="BtnStartTui" Height="48" FontWeight="Bold" FontSize="13"
                                Margin="0,0,0,4" Background="{DynamicResource Brush.ActionPositive}">
                            <StackPanel Orientation="Vertical">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <TextBlock x:Name="BtnStartTuiSymbol" Text="▶" Foreground="Green"
                                               FontWeight="Bold" FontSize="16" VerticalAlignment="Center" Margin="0,0,8,0" />
                                    <TextBlock x:Name="BtnStartTuiLabel" Text="OpenClaw TUI" VerticalAlignment="Center" />
                                </StackPanel>
                                <TextBlock x:Name="BtnStartTuiSubLabel" Text="(restart Gateway)"
                                           HorizontalAlignment="Center" FontSize="10" FontWeight="Normal" Foreground="Gray" />
                            </StackPanel>
                        </Button>

                        <!-- Gateway tlačítka -->
                        <TextBlock x:Name="TxtGatewayLabel" Text="Gateway:" FontWeight="Bold" Margin="0,2,0,3" />
                        <Grid Margin="0,0,0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="4" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Button x:Name="BtnGatewayStart" Grid.Column="0" Height="28">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="▶" Foreground="Green" FontWeight="Bold" Margin="0,0,6,0" />
                                    <TextBlock x:Name="BtnGatewayStartLabel" Text="Start" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="BtnGatewayStop" Grid.Column="2" Height="28" IsEnabled="False">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="■" Foreground="Red" FontWeight="Bold" Margin="0,0,6,0" />
                                    <TextBlock x:Name="BtnGatewayStopLabel" Text="Stop" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </Grid>
                        <Button x:Name="BtnGatewayRestart" Height="28" Margin="0,0,0,4" IsEnabled="False">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <TextBlock Text="↻" Foreground="Orange" FontWeight="Bold" FontSize="14" Margin="0,0,6,0" />
                                <TextBlock x:Name="BtnGatewayRestartLabel" Text="Restart" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <!-- Otevřít -->
                        <TextBlock x:Name="TxtSectionOpen" Text="Otevřít:" FontWeight="Bold" Margin="0" Visibility="Collapsed" />
                        <Button x:Name="BtnOpenPowerShell" Height="28" Margin="0,0,0,2">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="⚡" FontFamily="Segoe UI Emoji" FontSize="14" Margin="0,0,8,0" />
                                <TextBlock x:Name="BtnPowerShellLabel" Text="PowerShell" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="BtnOpenGatewayLog" Height="28" Margin="0,0,0,4">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="📄" FontFamily="Segoe UI Emoji" FontSize="14" Margin="0,0,8,0" />
                                <TextBlock x:Name="BtnGatewayLogLabel" Text="Gateway log" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <!-- Nástroje -->
                        <TextBlock x:Name="TxtSectionTools" Text="Nástroje:" FontWeight="Bold" Margin="0" Visibility="Collapsed" />
                        <Button x:Name="BtnCleaningTool" Height="28" Margin="0,0,0,2">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🧹" FontFamily="Segoe UI Emoji" FontSize="14" Margin="0,0,8,0" />
                                <TextBlock x:Name="BtnCleaningToolLabel" Text="Vyčistit soubory" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="BtnTokenManager" Height="28" Margin="0,0,0,4">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🔑" FontFamily="Segoe UI Emoji" FontSize="14" Margin="0,0,8,0" />
                                <TextBlock x:Name="BtnTokenManagerLabel" Text="Správce API klíčů" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <!-- Údržba -->
                        <TextBlock x:Name="TxtSectionMaintenance" Text="Údržba:" FontWeight="Bold" Margin="0" Visibility="Collapsed" />
                        <Button x:Name="BtnDoctorFix" Height="28" Background="{DynamicResource Brush.ActionDanger}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🩺" FontFamily="Segoe UI Emoji" FontSize="14" Margin="0,0,8,0" />
                                <TextBlock x:Name="BtnDoctorFixLabel" Text="Opravit konfiguraci" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                    </StackPanel>
                </GroupBox>

                <!-- Sekce Měření latence -->
                <GroupBox x:Name="GrpLatency" Grid.Row="1" Header="Měření latence" Margin="6,3,6,3" Padding="6"
                          ToolTip="Měřeno z Gateway logu (res záznamy). Resetuje se při restartu Gateway.">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition />
                            <RowDefinition />
                            <RowDefinition />
                            <RowDefinition />
                        </Grid.RowDefinitions>
                        <TextBlock x:Name="TxtLatencyLast" Grid.Row="0" Grid.Column="0" Text="Poslední:" />
                        <TextBlock Grid.Row="0" Grid.Column="1" x:Name="LatencyLast" Text="—" />
                        <TextBlock x:Name="TxtLatencyAvg" Grid.Row="1" Grid.Column="0" Text="Průměr 10×:" />
                        <TextBlock Grid.Row="1" Grid.Column="1" x:Name="LatencyAvg" Text="—" />
                        <TextBlock x:Name="TxtLatencyMax" Grid.Row="2" Grid.Column="0" Text="Maximum:" />
                        <TextBlock Grid.Row="2" Grid.Column="1" x:Name="LatencyMax" Text="—" />
                        <TextBlock x:Name="TxtLatencyCount" Grid.Row="3" Grid.Column="0" Text="Requestů:" />
                        <TextBlock Grid.Row="3" Grid.Column="1" x:Name="LatencyCount" Text="—" />
                    </Grid>
                </GroupBox>

                <!-- Sekce Log aplikace -->
                <GroupBox x:Name="GrpAppLog" Grid.Row="2" Header="Log aplikace" Margin="6,3,6,6" Padding="6">
                    <ListBox x:Name="AppLog"
                             FontFamily="Consolas" FontSize="11"
                             BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.VerticalScrollBarVisibility="Auto" />
                </GroupBox>
            </Grid>

            <GridSplitter x:Name="MainGridSplitter" Grid.Column="1" Width="5"
                          HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                          Background="LightGray" />

            <!-- ════════════════════════════════════════════════════════════ -->
            <!-- v0.5: Pravý panel — Grid se dvěma vrstvami                    -->
            <!-- Vrstva 0: TerminalControl (TUI)                               -->
            <!-- Vrstva 1: SplashOverlay (video/PNG nad TUI, moderní pozadí)  -->
            <!-- ════════════════════════════════════════════════════════════ -->
            <Grid Grid.Column="2">

                <!-- Vrstva 0: Embedded TUI terminál (vždy přítomný) -->
                <views:TerminalControl x:Name="Terminal" />

                <!-- Vrstva 1: Splash overlay — pozadí ladí s nejtmavší fialovou ze splash.png -->
                <Border x:Name="SplashOverlay"
                        Background="{DynamicResource Brush.SplashModernBackground}"
                        Visibility="Collapsed">
                    <Grid>

                        <!-- Statický PNG fallback (embedded resource, vždy načten) -->
                        <Image x:Name="SplashImage"
                               Source="pack://application:,,,/Resources/splash.png"
                               Stretch="Uniform"
                               RenderOptions.BitmapScalingMode="HighQuality"
                               ImageFailed="SplashImage_ImageFailed" />

                        <!-- Video splash — MediaElement s UnloadedBehavior="Stop"
                             zastaví audio automaticky při skrytí overlay. -->
                        <MediaElement x:Name="SplashMedia"
                                      LoadedBehavior="Manual"
                                      UnloadedBehavior="Stop"
                                      Stretch="Uniform"
                                      HorizontalAlignment="Stretch"
                                      VerticalAlignment="Stretch"
                                      Visibility="Collapsed"
                                      MediaEnded="SplashMedia_MediaEnded"
                                      MediaFailed="SplashMedia_MediaFailed"
                                      MediaOpened="SplashMedia_MediaOpened" />

                        <!-- Progress bar — tenký pruh dole, jen při videu -->
                        <ProgressBar x:Name="SplashProgress"
                                     VerticalAlignment="Bottom"
                                     Height="3"
                                     Minimum="0"
                                     Maximum="1"
                                     Value="0"
                                     Visibility="Collapsed"
                                     BorderThickness="0"
                                     Background="Transparent"
                                     Foreground="#2563EB" />

                    </Grid>
                </Border>

            </Grid>

        </Grid>
    </DockPanel>
</Window>
